{"id": "NC-Q3R1-01-MODEL-EMPTY-ENDS-NEVER-POPULATED", "category": "q3r1-1", "what": "the model restores the generic assumption: a scope ends on a cgroup-empty notification merely because it is empty, though it was never populated", "files": ["crates/nexus-verifier-sandbox/src/scope/tests.rs"], "target": "lib", "test": "execution::tests::q3r1_01_a_never_populated_scope_stays_loaded_and_unconfirmed_before_its_backstop", "marker": "a never-populated scope ended on a cgroup-empty notification", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "a never-populated scope ended on a cgroup-empty notification"}
{"id": "NC-Q3R1-01B-MODEL-COLLECTS-RUNNING", "category": "q3r1-1", "what": "the model's manager collects a unit that has not ended (immediate unload)", "files": ["crates/nexus-verifier-sandbox/src/scope/tests.rs"], "target": "lib", "test": "execution::tests::q3r1_01_a_never_populated_scope_stays_loaded_and_unconfirmed_before_its_backstop", "marker": "a running scope was collected", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "a running scope was collected"}
{"id": "NC-Q3R1-02-EXIT-OBSERVATION-REAPS", "category": "q3r1-2", "what": "the helper's exit observation reaps it (WNOWAIT dropped): the helper is reaped before the operation is confirmed", "files": ["crates/nexus-verifier-sandbox/tests/support/never_populated.rs"], "target": "phase2_never_populated", "test": "controls::np_16_the_exit_observation_never_reaps", "marker": "the exit observation reaped the helper", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "the exit observation reaped the helper"}
{"id": "NC-Q3R1-02B-CASE-REAPS-HELPER", "category": "q3r1-2", "what": "the live case reaps the helper itself before its placement", "files": ["crates/nexus-verifier-sandbox/tests/phase2_live_sandbox.rs"], "target": "phase2_never_populated", "test": "controls::np_18_live_case_18_drives_exactly_this_qualification", "marker": "the case's world does try_reap", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "the case's world does try_reap"}
{"id": "NC-Q3R1-03-PRE-BACKSTOP-CONFIRMATION-ACCEPTED", "category": "q3r1-3", "what": "a retry before the backstop that confirms the operation is taken as the lifecycle", "files": ["crates/nexus-verifier-sandbox/tests/support/never_populated.rs"], "target": "phase2_never_populated", "test": "controls::np_03_a_confirmation_before_the_backstop_is_a_failure", "marker": "qualified a world that deviates from the lifecycle", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "qualified a world that deviates from the lifecycle: Qualified { unit: \"nexus-verifier-0123456789abcdef0123456789abcdef.scope\", error: \"Some(NotPlaced)\", unconfirmed_before_backstop: 0, collected_at: 25.005s, confirmed_on: 0 }"}
{"id": "NC-Q3R1-04-PLACEMENT-SUCCESS-ACCEPTED", "category": "q3r1-4", "what": "a proven placement of the unmovable process is accepted", "files": ["crates/nexus-verifier-sandbox/tests/support/never_populated.rs"], "target": "phase2_never_populated", "test": "controls::np_05_a_proven_placement_is_a_failure", "marker": "qualified a world that deviates from the lifecycle", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "qualified a world that deviates from the lifecycle: Qualified { unit: \"\", error: \"\", unconfirmed_before_backstop: 0, collected_at: 0ns, confirmed_on: 0 }"}
{"id": "NC-Q3R1-05-CASE-BACKSTOP-REMOVED", "category": "q3r1-5", "what": "the case's own runtime backstop (RuntimeMaxUSec) is removed: the production default", "files": ["crates/nexus-verifier-sandbox/tests/support/never_populated.rs"], "target": "phase2_never_populated", "test": "controls::np_15_the_case_s_backstop_is_its_own_and_leaves_room_for_a_retry", "marker": "the case does not set its own runtime backstop", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: the case does not set its own runtime backstop\n  left: 660\n right: 45"}
