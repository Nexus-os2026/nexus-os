{"id": "NC-Q1-NO-SUCH-UNIT-NAME", "item": 6, "what": "the production manager reads another error name as the manager's absence", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "const NO_SUCH_UNIT: &str = \"org.freedesktop.systemd1.NoSuchUnit\";", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: const NO_SUCH_UNIT: &str = \"org.freedesktop.systemd1.NoSuchUnit\";\n  left: 0\n right: 1"}
{"id": "NC-Q1-UNIT-EXISTS-NAME", "item": 7, "what": "the production manager reads another error name as a collision", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "const UNIT_EXISTS: &str = \"org.freedesktop.systemd1.UnitExists\";", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: const UNIT_EXISTS: &str = \"org.freedesktop.systemd1.UnitExists\";\n  left: 0\n right: 1"}
{"id": "NC-Q1-ANY-ERROR-IS-ABSENT", "item": 6, "what": "every GetUnit error is read as the manager's absence", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "Ok(Err(name)) if name == NO_SUCH_UNIT => Remote::Answered(Presence::Absent),", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: Ok(Err(name)) if name == NO_SUCH_UNIT => Remote::Answered(Presence::Absent),\n  left: 0\n right: 1"}
{"id": "NC-Q1-ANY-ERROR-IS-COLLISION", "item": 7, "what": "every StartTransientUnit error is read as a collision (no effect)", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "Ok(Err(name)) if name == UNIT_EXISTS => Started::Collision,", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: Ok(Err(name)) if name == UNIT_EXISTS => Started::Collision,\n  left: 0\n right: 1"}
{"id": "NC-Q1-LIVE-COUNT-STALE", "item": 12, "what": "the gate's pinned count omits a case (38 of 39)", "files": [".github/workflows/ci-phase2-linux-sandbox.yml"], "test": "phase2_tests::p2_g_10_the_live_gate_pins_every_case_and_the_host_qualification", "marker": "the pinned count is every case", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: the pinned count is every case\n  left: 38\n right: 39"}
