{"id": "NC-R3R1-01-MEMBERSHIP-OWNS", "category": "r3r1-1", "what": "the helper's membership alone grants cleanup ownership: the cgroup settling retains through it is owned at once", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_02_a_same_name_replacement_holding_the_helper_is_never_ended_proven_or_launched", "marker": "the replacement's cgroup was owned through the helper's membership", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "replaced after the execution: the replacement's cgroup was owned through the helper's membership: PendingState { issued: true, collided: false, accepted: true, instance: true, candidate: true, owned: true, settled: false }"}
{"id": "NC-R3R1-02-KILL-AT-OPEN", "category": "r3r1-2", "what": "the candidate is ended as soon as it is opened, before any binding", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_04_an_identity_that_is_not_the_captured_one_is_never_bound", "marker": "a cgroup not bound to the captured identity was ended", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "another identity: a cgroup not bound to the captured identity was ended"}
{"id": "NC-R3R1-03-LOST-COLLISION-OWNS", "category": "r3r1-3", "what": "an uncertain start (a lost UnitExists) retains the cgroup holding its helper and owns it: helper placement becomes cleanup authority", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_01_a_lost_collision_holding_the_helper_is_never_ended_proven_or_launched", "marker": "the foreign unit was killed", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "Timeout, retry 1: the foreign unit was killed"}
{"id": "NC-R3R1-04-LOST-COLLISION-PROVEN", "category": "r3r1-4", "what": "an uncertain start (a lost UnitExists) goes on to the proof, which takes the identity the manager reports later: matching manager properties make the foreign cgroup proven", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_01_a_lost_collision_holding_the_helper_is_never_ended_proven_or_launched", "marker": "the foreign cgroup was launched into", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "Timeout: the foreign cgroup was launched into"}
{"id": "NC-R3R1-05-IDENTITY-MISMATCH-IGNORED", "category": "r3r1-5", "what": "the manager's identity for the unit is not compared: a different identity binds", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_04_an_identity_that_is_not_the_captured_one_is_never_bound", "marker": "launched into an unbound cgroup", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "another identity: launched into an unbound cgroup"}
{"id": "NC-R3R1-06-LATER-UNBOUND-IDENTITY", "category": "r3r1-6", "what": "the accepted start's identity is read later by the unit's name instead of captured from the start's own job", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "test": "execution::tests::r3r1_02_a_same_name_replacement_holding_the_helper_is_never_ended_proven_or_launched", "marker": "the replacement was launched into", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "the replacement was launched into"}
