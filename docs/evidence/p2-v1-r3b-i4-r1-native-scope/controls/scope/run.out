{"id": "NC-I4R1-SPAWN-BEFORE-IDENTITY", "category": "i4r1-required", "what": "the helper is spawned before its identity is allocated (the I4 order)", "files": ["crates/nexus-verifier-sandbox/src/launcher.rs"], "edits": 2, "test": "execution::tests::i4r1_21_no_helper_is_spawned_once_identities_are_exhausted", "marker": "a helper was spawned without an identity", "mapping": null, "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: a helper was spawned without an identity\n  left: 1\n right: 0"}
{"id": "NC-I4R1-HARNESS-WEAK-OWNER", "category": "i4r1-required", "what": "the harness's direct start owns the operation in a local until it is proven, not with its helper", "files": ["crates/nexus-verifier-sandbox/src/execution.rs"], "edits": 1, "test": "execution::tests::i4r1_02_a_direct_placement_failure_returns_one_owner_of_the_operation_and_its_helper", "marker": "the direct owner lost the unresolved operation", "mapping": null, "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "the direct owner lost the unresolved operation"}
