{"id": "NC-I4R1-X-ACCEPTED-EARLY", "category": "i4r1-additional", "what": "a start is taken as accepted when it is dispatched, before its reply is recorded", "files": ["crates/nexus-verifier-sandbox/src/scope/pending.rs"], "edits": 1, "test": "execution::tests::i4r1_01_a_panic_after_an_uncertain_start_without_a_candidate_keeps_its_owner", "marker": "a panic after an uncertain start lost or released its operation", "mapping": null, "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: AfterScopeStart: a panic after an uncertain start lost or released its operation\n  left: SandboxSetupFailed\n right: CleanupFailed"}
