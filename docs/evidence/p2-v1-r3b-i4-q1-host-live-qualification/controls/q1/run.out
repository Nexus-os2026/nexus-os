{"id": "NC-Q1-NO-SUCH-UNIT-NAME", "item": 6, "what": "the production manager reads another error name as the manager's absence", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "const NO_SUCH_UNIT: &str = \"org.freedesktop.systemd1.NoSuchUnit\";", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: const NO_SUCH_UNIT: &str = \"org.freedesktop.systemd1.NoSuchUnit\";\n  left: 0\n right: 1"}
{"id": "NC-Q1-UNIT-EXISTS-NAME", "item": 7, "what": "the production manager reads another error name as a collision", "files": ["crates/nexus-verifier-sandbox/src/scope/manager.rs"], "test": "scope::tests::i4q1_the_manager_s_definite_answers_are_exactly_systemd_s_error_names", "marker": "const UNIT_EXISTS: &str = \"org.freedesktop.systemd1.UnitExists\";", "test_passes_unmutated": true, "compiled": true, "failed_intended_test": true, "marker_in_assertion": true, "files_restored": true, "exit": 101, "ok": true, "assertion": "assertion `left == right` failed: const UNIT_EXISTS: &str = \"org.freedesktop.systemd1.UnitExists\";\n  left: 0\n right: 1"}
