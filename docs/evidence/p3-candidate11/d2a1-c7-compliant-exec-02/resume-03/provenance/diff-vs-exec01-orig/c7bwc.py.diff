+    rec.log("\n" + verdict)
+    t1 = utcns()
+    od = os.path.join(evdir, "receipts/25-stage3-gate")
+    os.makedirs(od)
+    rec.write(os.path.join(od, "STAGE3-E-W.txt"))
+    with open(os.path.join(od, "STAGE3-E-W.json"), "x") as f:
+        json.dump({"mission": MISSION, "verdict": verdict, "admissible": ok, "failed_checks": sorted(set(rec.fails)), "mutant_worktree_existed": mutant_exists,
