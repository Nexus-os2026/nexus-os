+def order_checks(evdir):
+    """Proves 13.3 steps 3-4 from this mission's receipts: E-W build -> 8 E-W listings -> Stage-3 gate -> mutant worktree creation
+    -> patch -> E-W7 build -> 8 E-W7 listings. Every time is a UTC string with nanoseconds, so string order is time order."""
+    out = []
+    rp = lambda *a: os.path.join(evdir, "receipts", *a)  # noqa
+    try:
+        bw = jload(rp("10-build-E-W", "descriptor.json"))
+        lw = [jload(rp("20-list-E-W", sp[0], "descriptor.json")) for sp in LIST_SPECS]
+        g3 = jload(rp("25-stage3-gate", "STAGE3-E-W.json"))
+        cm = jload(rp("00-worktrees", "creation-M.json"))
+        ap = jload(rp("00-worktrees", "apply-C7.json"))
+        b7 = jload(rp("11-build-E-W7", "descriptor.json"))
+        l7 = [jload(rp("21-list-E-W7", sp[0], "descriptor.json")) for sp in LIST_SPECS]
+    except Exception as e:  # noqa: BLE001
+        return [("ORD-0", "every order receipt is present", False, repr(e))]
+    seq = [("E-W build", _desc_times(bw))] + [("E-W %s" % sp[0], _desc_times(d)) for sp, d in zip(LIST_SPECS, lw)] + \
+          [("Stage-3 gate", (g3.get("started_utc"), g3.get("finished_utc")))] + \
+          [("mutant worktree creation", (cm.get("started_utc"), cm.get("finished_utc")))] + \
+          [("C7 patch application", (ap.get("started_utc"), ap.get("finished_utc")))] + \
+          [("E-W7 build", _desc_times(b7))] + [("E-W7 %s" % sp[0], _desc_times(d)) for sp, d in zip(LIST_SPECS, l7)]
+    ok_all = all(a and b and a <= b for _, (a, b) in seq)
+    out.append(("ORD-1", "every stage of 13.3 steps 3-4 has a UTC start and finish, start <= finish", ok_all, ""))
+    bad = [(seq[i][0], seq[i + 1][0]) for i in range(len(seq) - 1) if not (seq[i][1][1] and seq[i + 1][1][0] and seq[i][1][1] <= seq[i + 1][1][0])]
+    out.append(("ORD-2", "strict sequence: E-W build < 8 E-W listings (in order) < Stage-3 gate < mutant worktree creation < C7 patch < E-W7 build < 8 E-W7 listings",
+                not bad, "out of order: %s" % bad if bad else ""))
+    out.append(("ORD-3", "the Stage-3 gate record judged E-W admissible before the mutant worktree existed",
+                g3.get("admissible") is True and g3.get("mutant_worktree_existed") is False, "admissible=%s mutant_existed=%s" % (g3.get("admissible"), g3.get("mutant_worktree_existed"))))
+    return out
+
+
