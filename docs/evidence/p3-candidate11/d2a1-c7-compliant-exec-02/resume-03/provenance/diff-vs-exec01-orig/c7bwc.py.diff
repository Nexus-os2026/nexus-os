+                  json.dumps(ts) if not seq_ok else "")
+    ok = not rec.fails
+    verdict = ("STAGE 3: E-W BUILD AND ALL EIGHT LISTINGS ADMISSIBLE — the mutant worktree may now be created (13.3 step 4)" if ok else
