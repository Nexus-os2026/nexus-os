+        sc = (cfg["src_counts"] or default_src_counts)()
+        tw = (info.get("parsed", {}).get("L1-list-all", {}).get("count"), info.get("parsed", {}).get("L2-list-ignored", {}).get("count"))
+        rec.check("S3-INV", "healthy inventory: W-TREE source %s, E-W listings %s, expectation (%d, %d)" % (sc, tw, cfg["all_count"], cfg["ign_count"]),
+                  tuple(sc) == tw == (cfg["all_count"], cfg["ign_count"]), "")
+        ts = []
+        for sp in LIST_SPECS:
