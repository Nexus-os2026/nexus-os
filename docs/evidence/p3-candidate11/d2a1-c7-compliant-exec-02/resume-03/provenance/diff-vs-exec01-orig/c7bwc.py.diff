+        rec.check("0A-2", "E-W is not E-C (cde9f9d2…)", pj["executable"]["sha256"] != cfg["e_c_sha"] and pj["executable"]["path"] != ec["pin"]["executable"], pj["executable"]["sha256"][:12])
+        checks, info = listing_checks(evdir, role, cfg, ec)
