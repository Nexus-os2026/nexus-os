+            # kill ITS OWN scope only; retried on each tick until the unit exists and the kill is accepted
+            k = subprocess.run(["systemctl", "--user", "kill", "--signal=SIGKILL", unit + ".scope"], capture_output=True, text=True)
+            disk["kill_rc"] = k.returncode
+            disk["kill_attempts"] = disk.get("kill_attempts", 0) + 1
+            if k.returncode == 0:
+                out.write("%s killed own scope %s.scope after %d attempt(s)\n" % (time.strftime("%H:%M:%S"), unit, disk["kill_attempts"]))
+                out.flush()
+        return f
