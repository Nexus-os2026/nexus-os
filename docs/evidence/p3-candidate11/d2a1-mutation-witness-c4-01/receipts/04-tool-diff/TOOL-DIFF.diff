+    j = next(k for k in range(i + 1, len(ls)) if ls[k].startswith("note: run with `RUST_BACKTRACE=1`"))
+    head = re.sub(r" panicked at \S+:$", f" panicked at {at}:", ls[i])
+    return "\n".join(ls[:i] + [head] + message + ls[j:])
