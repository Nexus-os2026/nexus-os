+def rust_joined(text):
+    """Source text with Rust string continuations joined (a backslash at a line's end drops the newline and the next
+    line's leading whitespace), so a format string written over several lines reads as printed."""
+    return re.sub(r"\\\n[ \t]*", "", text)
+
+
+def c4_fields(body, names):
+    """The fields of one C4 constant body, each written `    name: value,` (a value may span lines up to `    ],` or
+    `    },`); returns {name: value text} or None when the fields are not exactly `names`, in order."""
+    out, order = {}, []
+    for m in re.finditer(r"^    (\w+): (.*?),$(?=\n    \w+: |\Z)", body, re.M | re.S):
+        out[m.group(1)] = m.group(2)
+        order.append(m.group(1))
+    return out if order == names else None
+
+
+def c4_list(v, pairs=False):
+    if pairs:
+        return [[int(a), int(b)] for a, b in re.findall(r"\((\d+), (\d+)\)", v)]
+    return [int(x) for x in re.findall(r"\d+", v)]
+
+
+def c4_str(v):
+    m = re.fullmatch(r'"((?:[^"\\]|\\.)*)"', v.strip())
+    return m.group(1) if m else None
+
+
+def fmt_pairs(p):
+    return "[" + ", ".join(f"({a}, {b})" for a, b in p) + "]"
+
