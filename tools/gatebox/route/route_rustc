#!/bin/sh
''':'
# SB-3E route lane: RUSTC_WORKSPACE_WRAPPER (design 1.3). One file, read by
# POSIX sh first and by Python after: see the Python comment below.
case $0 in
/*) ;;
*) echo "route_rustc: must be run by its absolute path" >&2; exit 1 ;;
esac
ign= blk=
while IFS= read -r line; do
  case $line in
  SigIgn:*) ign=${line#SigIgn:} ;;
  SigBlk:*) blk=${line#SigBlk:} ;;
  esac
done </proc/self/status
environ=$(/usr/bin/python3 -I "$0" environ "$$") || exit 1
exec /usr/bin/python3 -I "$0" exec "$ign" "$blk" "$environ" "$@"
'''

# Adds `--cfg mother_route_seams` when, and only when, the crate name and the
# source path both match one of the four named units. Adds nothing else.
#
# Process state: the compiler gets exactly the state this wrapper received
# (environment block, ignored signals, blocked mask, umask, rlimits, cwd,
# inherited descriptors). Neither interpreter can do that alone, by
# measurement:
# - Python's startup sets SIGPIPE and SIGXFSZ to ignored (inherited across
#   exec) and, under a C or POSIX LC_CTYPE, sets LC_CTYPE=C.UTF-8 in its own
#   environment (PEP 538; `-I` prevents neither). The dispositions it found
#   are gone by the time this code runs.
# - sh's `exec` builds the environment from its variable table: it reorders
#   it, drops names that are not shell identifiers and sets PWD.
# So sh runs first and only reads: its own SigIgn and SigBlk, before any
# Python has run. A Python child, which changes nothing in the shell, reads
# the shell's exec-time environment block from /proc/<pid>/environ. sh then
# execs Python, which restores exactly those dispositions and that mask,
# checks /proc/self/status says so, and execs the compiler with that
# environment block, in order, as bytes. umask, rlimits, cwd and descriptors
# are not touched by either (the sh script descriptor and the log descriptor
# are close-on-exec). Anything that cannot be handed on verbatim is refused,
# never repaired.
#
# Each invocation is logged to `<CARGO_TARGET_DIR>.route_rustc.log`, a sibling
# of the target directory: the target directory is inventoried by A7, and the
# log's location is derived from a variable the shipped recipe sets too. The log
# corroborates; it is not the authority (candidate build scripts run beside it).
import json
import os
import signal
import sys

UNITS = frozenset(
    {
        ("nexus_governed_control", "crates/nexus-governed-control/src/lib.rs"),
        ("nexus_mother", "mother/src/lib.rs"),
        ("nexus_mother_host", "mother/host/src/lib.rs"),
        ("route_cells", "mother/host/tests/route_cells/main.rs"),
    }
)
CFG = ["--cfg", "mother_route_seams"]
# Handed on as one hex argument, well under the kernel's 128 KiB string limit.
MAX_ENVIRON = 48 * 1024


def refuse(why):
    sys.exit("route_rustc: " + why)


def parse_environment(block):
    """The block as an ordered name -> value map; refuses what execve cannot copy."""
    if block and not block.endswith(b"\0"):
        refuse("the received environment block is unterminated")
    env = {}
    for entry in block.split(b"\0")[:-1]:
        name, sep, value = entry.partition(b"=")
        if not sep or not name or name in env:
            refuse("the received environment cannot be passed on verbatim")
        env[name] = value
    return env


def environ_of_shell(pid):
    """Child mode: print the shell's exec-time environment block as hex."""
    if not pid.isdigit() or os.getppid() != int(pid):
        refuse("the environment reader is not the shell's child")
    try:
        with open("/proc/%s/environ" % pid, "rb") as f:
            block = f.read()
    except OSError as e:
        refuse("cannot read the received environment: %s" % e)
    if len(block) > MAX_ENVIRON:
        refuse("the received environment is too large to hand on")
    parse_environment(block)
    sys.stdout.write(block.hex())


def mask(text):
    text = text.strip()
    if len(text) != 16 or text.strip("0123456789abcdef"):
        refuse("the received signal state is unreadable")
    return int(text, 16)


def status_masks():
    with open("/proc/self/status") as f:
        fields = dict(line.split(":", 1) for line in f if ":" in line)
    return mask(fields.get("SigIgn", "")), mask(fields.get("SigBlk", ""))


def restore_signals(ign, blk):
    """Set every disposition and the mask to the received ones, then check."""
    for sig in signal.valid_signals():
        if sig not in (signal.SIGKILL, signal.SIGSTOP):
            ignored = ign >> (sig - 1) & 1
            signal.signal(sig, signal.SIG_IGN if ignored else signal.SIG_DFL)
    blocked = {sig for sig in range(1, 65) if blk >> (sig - 1) & 1}
    signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
    if status_masks() != (ign, blk):
        refuse("the received signal state cannot be restored exactly")


def crate_name(args):
    names = [args[i + 1] for i, arg in enumerate(args[:-1]) if arg == "--crate-name"]
    return names[0] if len(names) == 1 else None


def compile_through(ign, blk, environ, argv):
    ign, blk = mask(ign), mask(blk)
    try:
        env = parse_environment(bytes.fromhex(environ))
    except ValueError:
        refuse("the received environment is unreadable")
    if not argv:
        refuse("no compiler given")
    target = os.fsdecode(env.get(b"CARGO_TARGET_DIR", b""))
    if not target.startswith("/"):
        refuse("CARGO_TARGET_DIR must be an absolute path")
    rustc, args = argv[0], argv[1:]
    name = crate_name(args)
    sources = [arg for arg in args if arg.endswith(".rs") and not arg.startswith("-")]
    added = len(sources) == 1 and (name, sources[0]) in UNITS
    entry = {"crate": name, "source": sources, "added": added}
    fd = os.open(
        target + ".route_rustc.log",
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC,
        0o644,
    )
    try:
        os.write(fd, (json.dumps(entry, sort_keys=True) + "\n").encode())
    finally:
        os.close(fd)
    restore_signals(ign, blk)
    os.execve(rustc, [rustc] + args + (CFG if added else []), env)


def main():
    mode = sys.argv[1:2]
    if mode == ["environ"] and len(sys.argv) == 3:
        environ_of_shell(sys.argv[2])
    elif mode == ["exec"] and len(sys.argv) >= 5:
        compile_through(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
    else:
        refuse("run as a compiler wrapper, through its sh front")


if __name__ == "__main__":
    main()
