        /// SB-3E S4b (design 4.2, 4.5): poisons `Coordinator.inner` by a caught
        /// panic while it is held (a prior panic under it); nothing else changes.
        /// It never waits for the lock: applied while the route holds it (after the
        /// lock is taken), it poisons nothing.
        impl<P: EffectPort> FileSession<P> {
            pub fn route_poison_coordinator(&self) {
                const M: &str = "nexus-mother-route-seam-S4b";
                std::hint::black_box(M.as_bytes());
                let _ =
                    std::panic::catch_unwind(std::panic::AssertUnwindSafe(||
                                {
                                    let _held = self.coordinator.inner.try_lock();
                                    {
                                        ::core::panicking::panic_fmt(format_args!("route seam S4b: coordinator lock poisoned"));
                                    };
                                }));
            }
        }
=== lane	pub mod coordinator > impl Inner	fn write_record ( & mut self , mission : MissionId , event : Event , poison : bool ) -> Result < u64 , CoordinatorError >	count 1	bytes 2908
        fn write_record(&mut self, mission: MissionId, event: Event,
            poison: bool) -> Result<u64, CoordinatorError> {
            self.usable()?;
            if let Err(code) = check(&event) {
                return Err(CoordinatorError::Journal(JournalError::Inconsistent {
                                line: self.next_seq as usize + 1,
                                code,
                            }));
            }
            let entry =
                Entry::chained(self.next_seq, &self.head, mission, event);
            let work = journal_work(&entry.event);
            let line = entry.to_line();
            if let Event::LaneReturned { invocation, .. } = &entry.event {
                let ctx =
                    crate::route_seams::Ctx::of(self.session_context.as_ref());
                crate::route_seams::at("mother.admit",
                    ctx.invocation(*invocation));
            }
            if work {
                self.admit_session(nexus_governed_control::host_session::MotherStep::Transition)?;
            }
            if let Event::LaneReturned { invocation, .. } = &entry.event {
                let ctx =
                    crate::route_seams::Ctx::of(self.session_context.as_ref());
                crate::route_seams::at("mother.admit.ok",
                    ctx.invocation(*invocation));
            }
            match &entry.event {
                Event::SessionOpened | Event::SessionClosed =>
                    self.invalidate_calls(),
                Event::LaneReturned { .. } | Event::LaneOvertaken { .. } |
                    Event::Transition { .. } | Event::SettlementStarted { .. } |
                    Event::Held { .. } => {
                    if let Some(mission) = self.missions.get_mut(&mission) {
                        mission.invalidate_calls();
                    }
                }
                _ => {}
            }
            if let Event::Transition { trigger } = &entry.event {
                if self.missions.get(&mission).is_some_and(|m|
                            transition(m.state,
                                    trigger).is_ok_and(|to| to.is_terminal())) {
                    self.mission(mission)?.terminal_record.get_or_insert((trigger.clone(),
                            None));
                }
            }
            if let Err(e) = self.store.append(&line) {
                self.broken = true;
                self.invalidate_calls();
                let owed = (self.fence)();
                self.owed.extend(owed);
                if poison && self.store.poison().is_err() {
                    return Err(CoordinatorError::Journal(JournalError::Store(StoreFailure::PoisonFailed)));
                }
                return Err(CoordinatorError::Journal(e));
            }
            self.head = entry.hash;
            self.next_seq += 1;
            Ok(entry.seq)
        }
=== lane	pub mod coordinator > impl < P : EffectPort > Coordinator < P >	fn run_lanes ( & self , id : MissionId , generation : u64 , roles : & [ LaneRole ] , report : & mut Advance ) -> Result < Ended , CoordinatorError >	count 1	bytes 12812
        /// Run `roles` in order for a reserved mission, and the effects they ask
        /// for. `generation` is the reservation: if the mission moved (a Stop),
        /// nothing more is called or dispatched.
        fn run_lanes(&self, id: MissionId, generation: u64,
            roles: &[LaneRole], report: &mut Advance)
            -> Result<Ended, CoordinatorError> {
            for (index, role) in roles.iter().enumerate() {
                self.file_boundary(id)?;
                let lane = self.lanes.get(*role);
                let identity = lane.identity();
                if self.port.emergency_stopped() {
                    self.stop_for(id, StopReason::EmergencyStop)?;
                    return Err(CoordinatorError::Stopped);
                }
                let verification =
                    match self.page_verification(id, generation, *role, report)?
                        {
                        Ok(verification) => verification,
                        Err(state) => return Ok(Ended::Ended(state)),
                    };
                let cap = lane.max_model_calls();
                let model =
                    (cap > 0).then(|| self.port.model_identity()).flatten();
                let (step, caller, lane_contract) =
                    self.step(|inner|
                                {
                                    inner.mission(id)?.proof.input = verification;
                                    if identity.role != *role {
                                        return Ok((Then::End(BlockReason::LaneIdentityChanged),
                                                    None, None));
                                    }
                                    if cap > 0 {
                                        let c = inner.mission(id)?.contract()?;
                                        let reason =
                                            match (&c.model, &model) {
                                                (Some(pin), Some(view)) if
                                                    self.file.is_some() &&
                                                        c.deliverable.as_deref() == Some("index.html") => {
                                                    (pin.name != view.name || pin.digest != view.digest ||
                                                                pin.identity !=
                                                                    view.identity).then_some(BlockReason::ModelIdentityChanged)
                                                }
                                                _ => Some(BlockReason::ModelNotPinned),
                                            };
                                        if let Some(reason) = reason {
                                            return Ok((Then::End(reason), None, None));
                                        }
                                    }
                                    let step =
                                        model_calls::reserve_lane(inner, id, generation, &identity,
                                                cap, &*self.clock)?;
                                    let caller =
                                        match &step {
                                            Then::Go(input) if cap > 0 =>
                                                Some(model_calls::Caller::reserved(self, inner,
                                                            input.invocation, generation)?),
                                            _ => None,
                                        };
                                    let lane_contract =
                                        if #[allow(non_exhaustive_omitted_patterns)] match &step {
                                                        Then::Go(_) => true,
                                                        _ => false,
                                                    } && *role == LaneRole::Builder && cap > 0 {
                                            Some(inner.mission(id)?.contract()?.clone())
                                        } else { None };
                                    Ok((step, caller, lane_contract))
                                })?;
                let input =
                    match self.then(id, step)? {
                        Ok(input) => input,
                        Err(state) => return Ok(Ended::Ended(state)),
                    };
                if let Some(caller) = &caller {
                    if caller.admit().is_err() {
                        return Ok(Ended::Ended(self.end(id,
                                            BlockReason::ModelAdmissionRefused)?));
                    }
                }
                self.file_boundary(id)?;
                if let Some(context) = self.port.session_context() {
                    context.admit(nexus_governed_control::host_session::MotherStep::LaneInvocation).map_err(|_|
                                CoordinatorError::Stopped)?;
                }
                let context =
                    crate::lane::LaneContext {
                        contract: lane_contract.as_ref(),
                        model: caller.as_ref().map(|c|
                                c as &dyn crate::lane::ModelCaller),
                    };
                let output = lane.invoke_in(&input, &context);
                drop(caller);
                if cap > 0 {
                    let terminal =
                        match output.verdict {
                            Verdict::Fail { .. } if *role == LaneRole::Verifier => {
                                Some(Trigger::VerifyFail {
                                        reason: VerifyFailReason::VerifierFailed,
                                    })
                            }
                            Verdict::Fail { .. } =>
                                Some(Trigger::Fail { reason: FailReason::LaneFail(*role) }),
                            Verdict::Halt { .. } =>
                                Some(Trigger::Block {
                                        reason: BlockReason::LaneHalt(*role),
                                    }),
                            _ => None,
                        };
                    if let Some(trigger) = terminal {
                        let ended = self.end_with(id, trigger);
                        self.model_obligations()?;
                        return Ok(Ended::Ended(ended?));
                    }
                }
                let boundary = self.file_boundary(id);
                self.model_obligations()?;
                boundary?;
                let hash = output_hash(&output);
                crate::route_seams::at("mother.lane.prelock",
                    crate::route_seams::Ctx::of(self.port.session_context().as_ref()).invocation(input.invocation));
                let contract =
                    self.step(|inner|
                                {
                                    inner.kept(id)?;
                                    let m = inner.mission(id)?;
                                    if m.generation != generation ||
                                            m.pending_lane != Some(input.invocation) {
                                        if m.pending_lane != Some(input.invocation) {
                                            return Err(CoordinatorError::Stopped);
                                        }
                                        inner.append(id,
                                                Event::LaneOvertaken { invocation: input.invocation })?;
                                        let m = inner.mission(id)?;
                                        m.pending_lane = None;
                                        m.invalidate_calls();
                                        return Err(CoordinatorError::Stopped);
                                    }
                                    inner.append(id,
                                            Event::LaneReturned {
                                                invocation: input.invocation,
                                                output_hash: hash.clone(),
                                            })?;
                                    crate::route_seams::at("mother.lane.returned",
                                        crate::route_seams::Ctx::of(inner.session_context.as_ref()).invocation(input.invocation));
                                    let mission = inner.mission(id)?;
                                    mission.pending_lane = None;
                                    mission.invalidate_calls();
                                    mission.prior_outputs.push(hash.clone());
                                    Ok(mission.contract()?.clone())
                                })?;
                report.lanes.push(LaneReport {
                        invocation: input.invocation,
                        identity,
                        text: output.text.clone(),
                        verdict: output.verdict.clone(),
                        input_hash: input_hash(&input),
                        output_hash: hash,
                    });
                let page =
                    contract.page_facts.is_some() && self.file.is_some();
                if *role == LaneRole::Verifier && page {
                    if let Some(state) =
                            self.page_verdict(id, generation, &input, &output, report)?
                        {
                        return Ok(Ended::Ended(state));
                    }
                }
                let verdict_end =
                    match (&output.verdict, *role) {
                        (Verdict::Halt { reason }, role) =>
                            Some((Trigger::Block {
                                        reason: BlockReason::LaneHalt(role),
                                    }, Some(reason))),
                        (Verdict::Fail { reason }, LaneRole::Verifier) =>
                            Some((Trigger::VerifyFail {
                                        reason: VerifyFailReason::VerifierFailed,
                                    }, Some(reason))),
                        (Verdict::Fail { reason }, role) =>
                            Some((Trigger::Fail { reason: FailReason::LaneFail(role) },
                                    Some(reason))),
                        (Verdict::Continue, LaneRole::Verifier) =>
                            Some((Trigger::VerifyFail {
                                        reason: VerifyFailReason::VerifierGaveNoVerdict,
                                    }, None)),
                        _ => None,
                    };
                if let Some((trigger, reason)) = verdict_end {
                    if let Some(reason) = reason {
                        let detail =
                            WorkingDetail::new("lane",
                                    role.as_str()).and("lane reason", reason);
                        self.step(|inner|
                                    { inner.set_detail(id, detail); Ok(()) })?;
                    }
                    return Ok(Ended::Ended(self.end_with(id, trigger)?));
                }
                let page =
                    *role == LaneRole::Builder && contract.page_facts.is_some();
                if page && page_proof::deliverable(&output.effects).is_err() {
                    let reason = FailReason::DeliverableInvalid;
                    return Ok(Ended::Ended(self.end_with(id,
                                        Trigger::Fail { reason })?));
                }
                if output.effects.len() > MAX_EFFECTS_PER_CALL {
                    return Ok(Ended::Ended(self.end(id,
                                        BlockReason::TooManyEffects)?));
                }
                if let Ended::Ended(state) =
                        self.checked(id, &contract, &output.effects, report)? {
                    return Ok(Ended::Ended(state));
                }
                if *role == LaneRole::Builder && contract.page_facts.is_some()
                    {
                    let retained =
                        self.retain(id, generation, input.invocation,
                                &output.effects)?;
                    if let Ended::Ended(state) = retained {
                        return Ok(Ended::Ended(state));
                    }
                }
                if let Ended::Ended(state) =
                        self.dispatch(id, generation, &output.effects,
                                &roles[index + 1..], report)? {
                    return Ok(Ended::Ended(state));
                }
            }
            Ok(Ended::Through)
        }
