            fn settle(&self, call: u32) {
                let c = self.coordinator;
                route_seams::at("mother.settle", self.route_ctx());
                let _ =
                    c.try_with_lock(|i|
                            {
                                if i.usable().is_err() { return Ok(()); }
                                let m = i.mission(self.invocation.mission)?;
                                if m.generation == self.generation &&
                                            m.pending_lane == Some(self.invocation) &&
                                        m.call_accounting.as_ref().is_some_and(|a|
                                                a.next == call.saturating_add(1)) {
                                    if let Some(l) =
                                            m.lane_calls.as_mut().filter(|l|
                                                    {
                                                        l.invocation == self.invocation &&
                                                            l.generation == self.generation
                                                    }) {
                                        l.in_flight = false;
                                    }
                                }
                                Ok(())
                            });
            }
=== lane	pub mod coordinator > mod model_calls > impl < P : EffectPort > ModelCaller for Caller < '_ , P >	fn call ( & self , request : & ModelRequest ) -> Result < ModelReply , ModelCallError >	count 1	bytes 1534
            fn call(&self, request: &ModelRequest)
                -> Result<ModelReply, ModelCallError> {
                if !self.live() { return Err(ModelCallError::Invalidated); }
                let c = self.meter.coordinator;
                let attempt =
                    c.port.model_call(self.meter.invocation.mission, request,
                        self, self, &self.liveness.0);
                if #[allow(non_exhaustive_omitted_patterns)] match attempt {
                        Ok(ModelAttempt::Unrecorded(_)) => true,
                        _ => false,
                    } {
                    c.file.as_ref().expect("File caller").model_debt.store(true,
                        Ordering::Release);
                    self.deny(BlockReason::BrokerRefused(BrokerClass::EvidenceUnavailable));
                    return Err(ModelCallError::RecordUnavailable);
                }
                route_seams::at("mother.recheck", self.meter.route_ctx());
                if self.live() && self.deadline.expired() {
                    self.deny(BlockReason::BudgetTime);
                }
                match attempt {
                    Ok(ModelAttempt::Failed(class)) =>
                        Err(ModelCallError::Failed(class)),
                    Err(refusal) => Err(ModelCallError::Refused(refusal.class)),
                    Ok(ModelAttempt::Replied(reply)) if self.live() =>
                        Ok(reply),
                    _ => Err(ModelCallError::Invalidated),
                }
            }
