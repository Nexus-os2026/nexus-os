        impl SessionPort {
            pub fn new(door: SessionDoor, workspace: String) -> Self {
                Self {
                    inner: GovernedPort::from_door(PortDoor::Session(door)).with_workspace(workspace),
                }
            }
            pub(crate) fn continue_approval(&self,
                continuation:
                    nexus_governed_control::host_session::approval::ApprovalContinuation,
                mission: MissionId, generation: u64, effect: u64)
                -> Result<(Self, HaltCell), EffectRefusal> {
                let PortDoor::Session(door) =
                    &self.inner.door else {
                        return Err(refused(BrokerClass::Halted));
                    };
                let door =
                    door.continue_approval(continuation, mission.0, generation,
                                effect).map_err(|e| refused_by(e.class()))?;
                let cell = door.lifecycle_halt();
                let (attachment, _) =
                    self.inner.file_session.get().ok_or_else(||
                                refused(BrokerClass::NotAdmitted))?;
                let mut inner =
                    GovernedPort::from_registered_door(PortDoor::Session(door),
                        self.inner.file_port.clone());
                inner.runs = self.inner.runs.clone();
                inner.performed = self.inner.performed.clone();
                inner.cancel_failures = self.inner.cancel_failures.clone();
                inner.workspace = self.inner.workspace.clone();
                inner.admission_gate = self.inner.admission_gate.clone();
                if inner.file_session.set((attachment.clone(),
                                cell.clone())).is_err() {
                    return Err(refused(BrokerClass::Halted));
                }
                Ok((Self { inner }, cell))
            }
            pub fn performed(&self) -> usize { self.inner.performed() }
            pub fn file_binding_count(&self) -> usize {
                self.inner.file_binding_count()
            }
            pub fn context(&self) -> SessionContext {
                match &self.inner.door {
                    PortDoor::Session(door) => door.context(),
                    PortDoor::Legacy(_) => {
                        ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                                format_args!("SessionPort construction is mandatory")));
                    }
                }
            }
        }
