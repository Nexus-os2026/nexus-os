            fn charge(&self) -> Result<Charged, MeterRefusal> {
                let c = self.coordinator;
                if c.port.emergency_stopped() {
                    return Err(MeterRefusal::Stale);
                }
                let mut result = Err(MeterRefusal::Stale);
                route_seams::at("mother.charge.entry", self.route_ctx());
                c.try_with_lock(|inner|
                                {
                                    if inner.usable().is_err() ||
                                            inner.file_cell.as_ref().is_some_and(|cell|
                                                    cell.is_engaged()) {
                                        return Ok(());
                                    }
                                    let m = inner.mission(self.invocation.mission)?;
                                    if m.generation != self.generation ||
                                                                m.pending_lane != Some(self.invocation) ||
                                                            !m.state.is_working() || m.held.is_some() || !m.consented()
                                                || m.settlement.is_some() || m.terminal_record.is_some() {
                                        return Ok(());
                                    }
                                    let Some(live) =
                                        m.lane_calls.as_ref().filter(|l|
                                                {
                                                    l.invocation == self.invocation &&
                                                            l.generation == self.generation && !l.liveness.is_revoked()
                                                }) else { return Ok(()); };
                                    let Some(a) =
                                        m.call_accounting.as_ref() else { return Ok(()); };
                                    result =
                                        if live.in_flight {
                                            Err(MeterRefusal::InFlight)
                                        } else if a.next > a.cap || (a.next == 1 && !a.prepaid) ||
                                                (a.next > 1 && m.model_calls >= a.budget) {
                                            Err(MeterRefusal::Exhausted)
                                        } else if m.out_of_time(&*c.clock) ||
                                                    c.clock.monotonic_ms() >= live.at_mono_ms ||
                                                c.clock.wall_ms() >= live.at_wall_ms {
                                            Err(MeterRefusal::OutOfTime)
                                        } else { Ok(Charged { call: a.next }) };
                                    let Ok(charged) = result else { return Ok(()); };
                                    result = Err(MeterRefusal::NotRecorded);
                                    route_seams::at("mother.charge", self.route_ctx());
                                    inner.append(self.invocation.mission,
                                            Event::ModelCallCharged {
                                                invocation: self.invocation,
                                                call: charged.call,
                                            })?;
                                    route_seams::at("mother.charge.ok", self.route_ctx());
                                    let m = inner.mission(self.invocation.mission)?;
                                    m.call_accounting.as_mut().expect("checked accounting").charge(self.invocation,
                                                charged.call,
                                                &mut m.model_calls).map_err(|code|
                                                {
                                                    CoordinatorError::Journal(JournalError::Inconsistent {
                                                            line: self.invocation.seq as usize + 1,
                                                            code,
                                                        })
                                                })?;
                                    m.lane_calls.as_mut().expect("checked live invocation").in_flight
                                        = true;
                                    result = Ok(charged);
                                    Ok(())
                                }).map_err(|_|
                            {
                                if result == Err(MeterRefusal::NotRecorded) {
                                    MeterRefusal::NotRecorded
                                } else { MeterRefusal::Stale }
                            })?;
                result
            }
