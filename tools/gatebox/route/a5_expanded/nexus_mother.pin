        /// SB-3E S3's forwarder (design 4.2): `SessionPort::new` consumes the door,
        /// so the original door's revocation is reached through its port.
        impl SessionPort {
            pub fn route_revoke_original_grant(&self) -> bool {
                const M: &str = "nexus-mother-route-seam-S3-port";
                std::hint::black_box(M.as_bytes());
                match &self.inner.door {
                    PortDoor::Session(door) =>
                        door.route_revoke_original_grant(),
                    PortDoor::Legacy(_) => false,
                }
            }
        }
=== lane	pub mod adapter > impl EffectPort for GovernedPort	fn model_call ( & self , mission : MissionId , request : & ModelRequest , meter : & dyn CallMeter , deadline : & dyn CallDeadline , invocation : & InvocationObserver ) -> Result < ModelAttempt , EffectRefusal >	count 1	bytes 813
        /// No port lock is held across the broker's call or its record write.
        fn model_call(&self, mission: MissionId, request: &ModelRequest,
            meter: &dyn CallMeter, deadline: &dyn CallDeadline,
            invocation: &InvocationObserver)
            -> Result<ModelAttempt, EffectRefusal> {
            let run = self.model_run(mission)?;
            self.admit_host()?;
            let outcome =
                self.door.model_call(run, request, meter, deadline,
                            invocation).map_err(|e| refused_by(e.class()))?;
            let record = outcome.record();
            crate::route_seams::at("mother.classify",
                crate::route_seams::Ctx::of(self.door.context().as_ref()).run(run));
            Ok(classify(record, outcome.into_result()))
        }
