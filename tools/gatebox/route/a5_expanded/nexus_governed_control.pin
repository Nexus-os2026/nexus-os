=== lane	pub mod evidence_store > impl EvidenceStore	fn qualify ( conn : Connection ) -> Result < Self , Unqualified >	count 1	bytes 1939
        /// §3, in order: the settings were read back by `connect`; then
        /// `integrity_check`, the schema and identity row, the whole chain.
        fn qualify(conn: Connection) -> Result<Self, Unqualified> {
            let application_id: i64 =
                conn.query_row("PRAGMA application_id", [],
                            |row| row.get(0)).map_err(|_| Unqualified::Sqlite)?;
            if application_id != i64::from(APPLICATION_ID) {
                return Err(Unqualified::NotAStore);
            }
            if !integrity_ok(&conn) { return Err(Unqualified::Integrity); }
            if !schema_exact(&conn)? { return Err(Unqualified::Schema); }
            let store = identity(&conn)?;
            let rows =
                read_rows(&conn,
                            &::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("SELECT {0} FROM record ORDER BY seq",
                                                ROW_COLUMNS))
                                    }), &[]).ok_or(Unqualified::Chain)?;
            let (last_seq, last_tag) =
                verify_chain(&store, &rows).ok_or(Unqualified::Chain)?;
            if !acknowledgements_precede(&rows) {
                return Err(Unqualified::Chain);
            }
            let mut known = Known::default();
            for row in &rows { known.take(row); }
            let mut inner =
                Inner {
                    conn,
                    store,
                    session: random_hex()?,
                    last_seq,
                    last_tag,
                    latched: false,
                    known,
                    owed: VecDeque::new(),
                    route_refuse: None,
                    owed_flush: false,
                };
            inner.open_session()?;
            inner.reconcile()?;
            Ok(Self { inner: Mutex::new(inner) })
        }
=== lane	pub mod evidence_store > impl EvidenceStore	fn inner ( & self ) -> MutexGuard < '_ , Inner >	count 1	bytes 483
        /// The store's state, under its mutex. A panic while it was held (it
        /// was poisoned) latches it: what that append did cannot be known.
        fn inner(&self) -> MutexGuard<'_, Inner> {
            match self.inner.lock() {
                Ok(inner) => inner,
                Err(poisoned) => {
                    let mut inner = poisoned.into_inner();
                    inner.latched = true;
                    inner
                }
            }
        }
