        pub fn halt(&self, reason: crate::governed::HaltReason)
            -> Result<crate::governed::RecordBatch, SessionFailure> {
            route_seams::at("door.halt", self.context.scope.route_ctx());
            let call = close::settlement(&self.core)?;
