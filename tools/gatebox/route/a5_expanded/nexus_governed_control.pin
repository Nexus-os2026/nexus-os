=== lane	pub mod authority > pub mod run > impl RunRegistry	pub ( crate ) fn route_poison_runs ( & self )	count 1	bytes 771
            /// SB-3E S4 (AM-2 B.2): a panic while the run table is held, caught; it
            /// poisons that one lock and changes nothing else.
            pub(crate) fn route_poison_runs(&self) {
                const M: &str = "nexus-mother-route-seam-S4-runs";
                std::hint::black_box(M.as_bytes());
                let _ =
                    std::panic::catch_unwind(std::panic::AssertUnwindSafe(||
                                {
                                    let _held = self.runs.lock();
                                    {
                                        ::core::panicking::panic_fmt(format_args!("route seam S4: run table poisoned"));
                                    };
                                }));
            }
=== lane	pub mod authority > pub mod run > impl RunRegistry	pub ( crate ) fn admit_session_attempt ( self : & Arc < Self > , ( run , agent , group , identity ) : ( RunId , & AgentId , GroupId , [ u8 ; 32 ] ) ,	count 1	bytes 4683
            pub(crate) fn admit_session_attempt(self: &Arc<Self>,
                (run, agent, group, identity):
                    (RunId, &AgentId, GroupId, [u8; 32]), original: &HaltCell,
                grant: &OriginalGrant<'_>,
                invocation: &crate::inference::InvocationObserver)
                -> Result<SessionAttempt, AuthorityError> {
                let mut table =
                    self.runs.try_lock().map_err(|error|
                                {
                                    if #[allow(non_exhaustive_omitted_patterns)] match error {
                                            TryLockError::Poisoned(_) => true,
                                            _ => false,
                                        } {
                                        original.fail_session();
                                    }
                                    AuthorityError::Unavailable("model run hold unavailable")
                                })?;
                if self.stopped.load(Ordering::SeqCst) {
                    return Err(AuthorityError::EmergencyStopped);
                }
                if self.closed.load(Ordering::SeqCst) {
                    return Err(AuthorityError::Closed("the desktop is quitting"));
                }
                let door =
                    crate::governed::AgentDoor::retained_identity(&live_door(&mut table.doors,
                                                group, agent)?.life, group, agent,
                                original).ok_or(AuthorityError::NotMember)?;
                let door_halted =
                    live_door(&mut table.doors, group,
                                    agent)?.halt_flag.clone();
                let entry =
                    table.runs.get(&run).ok_or(AuthorityError::UnknownRun)?;
                live_member(&table, entry, agent, group)?;
                host_prerequisites(&table, entry,
                        self.stop_number.load(Ordering::SeqCst))?;
                let cell =
                    entry.file_cell.as_ref().filter(|c|
                                        c.host() &&
                                            c.same(original)).ok_or(AuthorityError::NotMember)?.clone();
                if entry.opened_by != Some(group) {
                    return Err(AuthorityError::NotMember);
                }
                let files =
                    entry.files_admission.as_ref().ok_or(AuthorityError::NotAdmitted)?;
                let admission =
                    entry.inference_admission.as_ref().ok_or(AuthorityError::NotAdmitted)?;
                if admission.identity != identity {
                    return Err(AuthorityError::ModelIdentityMismatch);
                }
                if admission.contract_hash != files.contract_hash ||
                                    admission.request != files.request ||
                                admission.evidence_seq != files.evidence_seq ||
                            admission.kind != files.kind ||
                        admission.consented_wall_ms != files.consented_wall_ms {
                    return Err(AuthorityError::NoConsent);
                }
                if entry.model_attempts >= MAX_MODEL_ATTEMPTS {
                    return Err(AuthorityError::ModelCall(ModelError::OverBudget));
                }
                let ordinal =
                    entry.model_attempts.checked_add(1).ok_or(AuthorityError::Capacity)?;
                let _grant_held = grant.live(files)?;
                route_seams::at("model.attempt.granted",
                    Ctx::default().run(run).attempt(ordinal));
                let ticket =
                    SessionAttempt {
                        run,
                        agent: agent.clone(),
                        group,
                        admission: admission.clone(),
                        ordinal,
                        door,
                        registry: Arc::downgrade(self),
                        cell: cell.clone(),
                        cancelled: entry.cancelled.clone(),
                        door_halted,
                    };
                let entry =
                    table.runs.get_mut(&run).ok_or(AuthorityError::UnknownRun)?;
                if invocation.is_revoked() {
                    return Err(AuthorityError::Halted);
                }
                route_seams::at("model.attempt.checked",
                    Ctx::default().run(run).attempt(ordinal));
                cell.admit()?;
                entry.model_attempts = ordinal;
                entry.model_pins.insert(ordinal);
                Ok(ticket)
            }
=== lane	pub mod authority > pub mod run > impl RunRegistry	pub ( crate ) fn settle_session_attempt ( & self , ticket : SessionAttempt , deadline : Instant ) -> Result < ( ) , AuthorityError >	count 1	bytes 1241
            pub(crate) fn settle_session_attempt(&self,
                ticket: SessionAttempt, deadline: Instant)
                -> Result<(), AuthorityError> {
                if !std::ptr::eq(self, ticket.registry.as_ptr()) {
                    return Err(AuthorityError::WrongRun);
                }
                route_seams::at("model.settle.before",
                    Ctx::default().run(ticket.run).attempt(ticket.ordinal));
                let mut table =
                    settlement_hold(&self.runs, &ticket.cell, deadline)?;
                let entry =
                    table.runs.get_mut(&ticket.run).ok_or(AuthorityError::UnknownRun)?;
                if entry.view.agent != ticket.agent ||
                                    entry.opened_by != Some(ticket.group) ||
                                entry.inference_admission.as_ref() !=
                                    Some(&ticket.admission) ||
                            !entry.file_cell.as_ref().is_some_and(|c|
                                        c.same(&ticket.cell)) ||
                        !entry.model_pins.remove(&ticket.ordinal) {
                    return Err(AuthorityError::WrongRun);
                }
                Ok(())
            }
=== lane	pub mod authority > pub mod run > impl RunRegistry	pub ( crate ) fn admit_session_inference ( & self , b : SessionBinding < '_ > ) -> Result < ( ) , AuthorityError >	count 1	bytes 6881
            pub(crate) fn admit_session_inference(&self,
                b: SessionBinding<'_>) -> Result<(), AuthorityError> {
                let mut table =
                    self.runs.try_lock().map_err(|error|
                                {
                                    if #[allow(non_exhaustive_omitted_patterns)] match error {
                                            TryLockError::Poisoned(_) => true,
                                            _ => false,
                                        } {
                                        b.original.fail_session();
                                    }
                                    AuthorityError::Unavailable("model run hold unavailable")
                                })?;
                if self.stopped.load(Ordering::SeqCst) {
                    return Err(AuthorityError::EmergencyStopped);
                }
                if self.closed.load(Ordering::SeqCst) {
                    return Err(AuthorityError::Closed("the desktop is quitting"));
                }
                let now =
                    Life {
                        stop_epoch: self.stop_number.load(Ordering::SeqCst),
                        halted: false,
                        closed: false,
                    };
                let door = live_door(&mut table.doors, b.group, b.agent)?;
                let listed = door.members.contains(&b.run);
                let door_cell = door.file_cell.clone();
                let mut matching =
                    door.consents.iter().filter(|c|
                            {
                                c.life == now && c.contract_hash == b.contract_hash &&
                                    c.request == b.request
                            });
                let consent = matching.next().cloned();
                let agreed =
                    consent.as_ref().is_some_and(|first|
                            matching.all(|c| c.page_facts == first.page_facts));
                let entry =
                    table.runs.get(&b.run).ok_or(AuthorityError::UnknownRun)?;
                if &entry.view.agent != b.agent {
                    return Err(AuthorityError::WrongAgent);
                }
                if entry.class != RunClass::Agent {
                    return Err(AuthorityError::WrongRun);
                }
                if entry.file_cell.as_ref().is_some_and(HaltCell::is_engaged)
                        || table.in_halted_group(entry) {
                    return Err(AuthorityError::Halted);
                }
                if entry.view.finished {
                    return Err(AuthorityError::RunNotActive);
                }
                if entry.view.cancelled ||
                        entry.cancelled.load(Ordering::SeqCst) {
                    return Err(AuthorityError::RunCancelled);
                }
                let s =
                    entry.file_cell.as_ref().is_some_and(|c|
                            c.host() && c.same(b.original));
                let d = listed && entry.groups.contains(&b.group);
                let r = entry.opened_by == Some(b.group);
                let cell =
                    door_cell.as_ref().is_none_or(|door|
                            entry.file_cell.as_ref().is_some_and(|c| c.same(door)));
                let id = entry.view.id == b.run;
                if !s || !d || !r || !cell || !id {
                    return Err(AuthorityError::NotMember);
                }
                let files =
                    entry.files_admission.as_ref().ok_or(AuthorityError::NotAdmitted)?;
                if b.q_run != Some(b.run) {
                    return Err(AuthorityError::NotMember);
                }
                let (grant, _grant_held) =
                    b.grants.try_live_at(b.grant, b.clock.0,
                                b.clock.1).map_err(|error|
                                {
                                    if error == super::policy::GrantObservation::Poisoned {
                                        return AuthorityError::Unavailable(GRANT_POISONED);
                                    }
                                    AuthorityError::Unavailable("model grant hold unavailable")
                                })?;
                if !#[allow(non_exhaustive_omitted_patterns)] match grant {
                            Some(super::policy::GrantScope::Files { workspace, identity,
                                .. }) if
                                workspace == files.workspace.id &&
                                    identity == files.workspace.identity => true,
                            _ => false,
                        } {
                    return Err(AuthorityError::GrantNotLive);
                }
                let consent =
                    consent.filter(|_|
                                    agreed).ok_or(AuthorityError::NoConsent)?;
                let fresh =
                    match &entry.inference_admission {
                        Some(bound) if
                            bound.contract_hash == consent.contract_hash &&
                                    bound.request == consent.request &&
                                bound.identity == b.identity => {
                            false
                        }
                        Some(_) => return Err(AuthorityError::AlreadyAdmitted),
                        None => true,
                    };
                if consent.contract_hash != files.contract_hash ||
                                        consent.request != files.request ||
                                    consent.evidence_seq != files.evidence_seq ||
                                consent.kind != files.kind ||
                            consent.at_wall_ms != files.consented_wall_ms ||
                        consent.page_facts != files.page_facts {
                    return Err(AuthorityError::NoConsent);
                }
                let admission =
                    InferenceAdmission {
                        contract_hash: consent.contract_hash,
                        request: consent.request,
                        evidence_seq: consent.evidence_seq,
                        kind: consent.kind,
                        consented_wall_ms: consent.at_wall_ms,
                        identity: b.identity,
                    };
                route_seams::at("model.bind.checked",
                    Ctx::default().run(b.run));
                b.original.admit()?;
                if fresh {
                    let entry =
                        table.runs.get_mut(&b.run).ok_or(AuthorityError::UnknownRun)?;
                    entry.inference_admission = Some(admission);
                }
                route_seams::at("bind.done", Ctx::default().run(b.run));
                Ok(())
            }
=== lane	pub mod broker	impl ReleaseCredential for CredentialBroker	count 1	bytes 3894
    impl ReleaseCredential for CredentialBroker {
        fn release(&self, lease_id: LeaseId, guard: &ExecutionGuard,
            destination: &Destination)
            -> Result<SecretHeader, AuthorityError> {
            let prepared =
                self.commitments.prepared_for(guard).ok_or(AuthorityError::NotAuthorized)?;
            if !prepared.leases.contains(&lease_id) {
                return Err(AuthorityError::Closed("the lease is not bound to this commitment"));
            }
            let view =
                self.commitments.view(guard.commitment()).ok_or(AuthorityError::UnknownCommitment)?;
            let now = self.clock.monotonic_ms();
            let (spec, privacy) =
                {
                    let mut leases = self.table.leases.lock().expect("leases");
                    let lease =
                        leases.map.get_mut(&lease_id).ok_or(AuthorityError::UnknownLease)?;
                    if lease.agent != view.agent {
                        return Err(AuthorityError::WrongAgent);
                    }
                    if lease.run != view.run {
                        return Err(AuthorityError::WrongRun);
                    }
                    if lease.state != LeaseState::Issued {
                        return Err(AuthorityError::NotPending);
                    }
                    if now >= lease.deadline_ms {
                        lease.state = LeaseState::Ended;
                        return Err(AuthorityError::Expired);
                    }
                    if destination.origin_text() != lease.origin {
                        return Err(AuthorityError::TargetChanged);
                    }
                    lease.state = LeaseState::Released;
                    (lease.spec, lease.privacy)
                };
            let mut record =
                EvidenceRecord::new(EvidencePhase::CredentialReleased,
                    self.clock.wall_ms(), self.generation.current(), privacy);
            record.commitment = Some(guard.commitment().to_string());
            record.agent = Some(view.agent.to_string());
            record.run = Some(view.run.to_string());
            record.target = Some(destination.origin_text());
            record.detail.push(("lease".into(), lease_id.to_string()));
            record.detail.push(("service".into(), spec.service.into()));
            self.record(record)?;
            self.still_releasing(lease_id, guard, &view)?;
            let secret = self.source.read(spec.scope, spec.name);
            self.still_releasing(lease_id, guard, &view)?;
            let secret =
                secret.map_err(|_|
                            AuthorityError::Unavailable("the credential is not available"))?;
            if secret.is_empty() ||
                    !secret.bytes().all(|b| (0x21..0x7f).contains(&b)) {
                return Err(AuthorityError::Unavailable("the credential is not a plain token"));
            }
            let (name, value) =
                match spec.placement {
                    Placement::Authorization(scheme) =>
                        (AUTHORIZATION,
                            Zeroizing::new(::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("{1} {0}", *secret,
                                                scheme))
                                    }))),
                    Placement::Header(header) =>
                        (HeaderName::from_bytes(header.as_bytes()).map_err(|_|
                                        AuthorityError::Unavailable("credential header is not valid"))?,
                            Zeroizing::new(secret.to_string())),
                };
            Ok(SecretHeader {
                    name,
                    value,
                    token: Zeroizing::new(secret.to_string()),
                })
        }
    }
