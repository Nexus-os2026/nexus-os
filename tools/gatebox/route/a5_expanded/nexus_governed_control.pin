        fn append(&mut self, phase: &str, commitment: Option<&str>,
            body: &str) -> Append {
            let kind =
                if std::mem::take(&mut self.owed_flush) {
                    "owed_flush"
                } else { "ordinary" };
            if self.latched { return Append::Latched; }
            let Some(seq) =
                self.last_seq.checked_add(1) else {
                    self.latch();
                    return Append::Uncertain;
                };
            let stored_ms = wall_ms();
            let tag =
                tag_of(&self.store, &self.last_tag, seq, &self.session,
                    stored_ms, phase, commitment, body);
            if self.conn.execute_batch("BEGIN IMMEDIATE").is_err() {
                if self.conn.is_autocommit() { return Append::NotCommitted; }
                self.latch();
                return Append::Uncertain;
            }
            if self.route_refused(kind, phase, commitment) {
                route_seams::note("store.refused",
                    Ctx::store(kind, phase, commitment));
                if rolled_back(&self.conn) { return Append::NotCommitted; }
                self.latch();
                return Append::Uncertain;
            }
            let inserted =
                self.conn.execute("INSERT INTO record (seq, session, stored_ms, phase, commitment, body, prev, tag) \
             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)",
                    &[&i64::try_from(seq).unwrap_or(i64::MAX) as
                                        &dyn ::rusqlite::ToSql,
                                    &self.session as &dyn ::rusqlite::ToSql,
                                    &i64::try_from(stored_ms).unwrap_or(i64::MAX) as
                                        &dyn ::rusqlite::ToSql, &phase as &dyn ::rusqlite::ToSql,
                                    &commitment as &dyn ::rusqlite::ToSql,
                                    &body as &dyn ::rusqlite::ToSql,
                                    &self.last_tag as &dyn ::rusqlite::ToSql,
                                    &tag as &dyn ::rusqlite::ToSql] as
                        &[&dyn ::rusqlite::ToSql]);
            match inserted {
                Ok(1) => {}
                Err(error) if is_unique_violation(&error) => {
                    if !rolled_back(&self.conn) {
                        self.latch();
                        return Append::Uncertain;
                    }
                    return self.already(phase, commitment, body);
                }
                Err(error) if is_constraint_violation(&error) => {
                    rolled_back(&self.conn);
                    self.latch();
                    return Append::Uncertain;
                }
                _ => {
                    if rolled_back(&self.conn) { return Append::NotCommitted; }
                    self.latch();
                    return Append::Uncertain;
                }
            }
            route_seams::at("store.commit",
                Ctx::store(kind, phase, commitment));
            if self.commit().is_err() {
                route_seams::note("store.commit.result",
                    Ctx::store(kind, phase, commitment));
                self.latch();
                return Append::Uncertain;
            }
            route_seams::at("store.commit.result",
                Ctx::store(kind, phase, commitment));
            self.known.take(&Row {
                        seq,
                        session: self.session.clone(),
                        stored_ms,
                        phase: phase.to_string(),
                        commitment: commitment.map(str::to_string),
                        body: body.to_string(),
                        prev: self.last_tag.clone(),
                        tag: tag.clone(),
                    });
            self.last_seq = seq;
            self.last_tag = tag;
            Append::Committed { seq }
        }
