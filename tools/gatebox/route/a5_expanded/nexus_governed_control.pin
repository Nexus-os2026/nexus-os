    pub mod route_seams {
        //! SB-3E S1 (design 4.2): the broker's route seams. Compiled only with
        //! `--cfg mother_route_seams`, which only the route lane's wrapper sets; the
        //! shipped build has none. The writers `at` and `note` are crate-private and
        //! called only at the audited sites of design 4.4 and the two store sites;
        //! the harness may only `arm` and `drain_trace`. `at` returns nothing: it
        //! records, may pause, or begins an unwind, and never returns into the route.
        use crate::authority::ids::RunId;
        use crate::host_session::SessionIdentity;
        use nexus_kernel::inference::RequestKind;
        use std::fs::File;
        use std::io::Write;
        use std::sync::atomic::{AtomicBool, Ordering};
        use std::sync::mpsc::{sync_channel, Receiver, SyncSender};
        use std::sync::{Arc, Mutex, MutexGuard, PoisonError};
        use std::time::{Duration, Instant};
        /// S1's marker (SB3E-R9): the first statement of each writer's real body.
        const M: &str = "nexus-mother-route-seam-S1";
        /// The bounded wait of every pause (design 3.5).
        const PATIENCE: Duration = Duration::from_secs(10);
        /// Every point a harness may arm: the broker rows of design 4.4 and S1's
        /// two store points.
        pub(crate) const POINTS: [&str; 35] =
            ["reg.reserve", "model.reserved", "model.record.before",
                    "model.install.before", "model.install.after", "reg.ready",
                    "identity", "bind.entry", "model.bind.checked", "bind.done",
                    "attempt.slot", "model.attempt.reserved",
                    "model.attempt.granted", "model.attempt.checked",
                    "model.gate.before", "model.gate.checked", "call.gate",
                    "model.call.sampled", "model.call.observed",
                    "model.call.admitted", "door.cancel_run", "door.halt",
                    "ingress.emergency", "ingress.accept",
                    "model.attempt.record.before", "model.settle.before",
                    "complete", "close.obligations", "producer.join",
                    "close.seal", "close.mother_end", "close.primary",
                    "close.delivery", "store.commit", "store.commit.result"];
        /// The per-request gate entries; each one advances `request_ordinal`.
        const GATES: [&str; 2] = ["model.gate.before", "call.gate"];
        static ARMED: AtomicBool = AtomicBool::new(false);
        static FAILED: AtomicBool = AtomicBool::new(false);
        static STATE: Mutex<State> =
            Mutex::new(State {
                    tick: 0,
                    entries: Vec::new(),
                    pending: Vec::new(),
                    ordinals: Vec::new(),
                });
        type Key =
            (Option<SessionIdentity>, Option<u64>, Option<RunId>,
            Option<u32>);
        struct State {
            tick: u64,
            entries: Vec<Entry>,
            pending: Vec<Pending>,
            ordinals: Vec<(Key, u64)>,
        }
        struct Pending {
            id: u64,
            point: &'static str,
            ack: SyncSender<Entry>,
            pause: Option<(Receiver<()>, &'static str, Arc<File>)>,
        }
        /// The identity a site knows (design 2.3); unknown fields stay `None`.
        pub(crate) struct Ctx<'a> {
            session: Option<SessionIdentity>,
            request: Option<u64>,
            run: Option<RunId>,
            attempt: Option<u32>,
            kind: Option<&'static str>,
            phase: Option<&'a str>,
            commitment: Option<&'a str>,
        }
        #[automatically_derived]
        #[doc(hidden)]
        unsafe impl<'a> ::core::clone::TrivialClone for Ctx<'a> { }
        #[automatically_derived]
        impl<'a> ::core::clone::Clone for Ctx<'a> {
            #[inline]
            fn clone(&self) -> Ctx<'a> {
                let _:
                        ::core::clone::AssertParamIsClone<Option<SessionIdentity>>;
                let _: ::core::clone::AssertParamIsClone<Option<u64>>;
                let _: ::core::clone::AssertParamIsClone<Option<RunId>>;
                let _: ::core::clone::AssertParamIsClone<Option<u32>>;
                let _:
                        ::core::clone::AssertParamIsClone<Option<&'static str>>;
                let _: ::core::clone::AssertParamIsClone<Option<&'a str>>;
                let _: ::core::clone::AssertParamIsClone<Option<&'a str>>;
                *self
            }
        }
        #[automatically_derived]
        impl<'a> ::core::marker::Copy for Ctx<'a> { }
        #[automatically_derived]
        impl<'a> ::core::default::Default for Ctx<'a> {
            #[inline]
            fn default() -> Ctx<'a> {
                Ctx {
                    session: ::core::default::Default::default(),
                    request: ::core::default::Default::default(),
                    run: ::core::default::Default::default(),
                    attempt: ::core::default::Default::default(),
                    kind: ::core::default::Default::default(),
                    phase: ::core::default::Default::default(),
                    commitment: ::core::default::Default::default(),
                }
            }
        }
        impl<'a> Ctx<'a> {
            pub(crate) fn session(session: SessionIdentity) -> Self {
                let session = Some(session);
                Self { session, ..Self::default() }
            }
            pub(crate) fn request(self, request: u64) -> Self {
                let request = Some(request);
                Self { request, ..self }
            }
            pub(crate) fn run(self, run: RunId) -> Self {
                Self { run: Some(run), ..self }
            }
            pub(crate) fn attempt(self, attempt: u32) -> Self {
                let attempt = Some(attempt);
                Self { attempt, ..self }
            }
            pub(crate) fn kind(self, kind: RequestKind) -> Self {
                let chat = kind == RequestKind::Chat;
                let kind = Some(if chat { "chat" } else { "metadata" });
                Self { kind, ..self }
            }
            /// A store append: its kind (`ordinary` or `owed_flush`) and record.
            pub(crate) fn store(kind: &'static str, phase: &'a str,
                commitment: Option<&'a str>) -> Self {
                let (kind, phase) = (Some(kind), Some(phase));
                Self { kind, phase, commitment, ..Self::default() }
            }
        }
        /// One trace entry (design 2.3). `note` marks a refusing branch's reason.
        pub struct Entry {
            pub tick: u64,
            pub point: &'static str,
            pub note: bool,
            pub session: Option<SessionIdentity>,
            pub request: Option<u64>,
            pub run: Option<RunId>,
            /// The broker sees no invocation identity (only its revocation).
            pub invocation: Option<u64>,
            pub attempt: Option<u32>,
            pub kind: Option<&'static str>,
            pub request_ordinal: Option<u64>,
            pub phase: Option<String>,
            pub commitment: Option<String>,
            /// The recording thread (AM-2 B.1: 4.2.1 consumption checks).
            pub thread: std::thread::ThreadId,
            /// When it was recorded (AM-2 B.1: position evidence only).
