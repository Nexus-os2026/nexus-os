            pub fn observe_mother_end(&self, seal: &CloseSeal)
                -> Result<(), SessionError> {
                route_seams::at("close.mother_end",
                    Ctx::session(self.core.identity));
                seal.live()?;
                if !Arc::ptr_eq(&self.core, &seal.core) {
                    return Err(SessionError::Restricted);
                }
                let finals = seal.finals()?;
                if finals.mother.load(Ordering::SeqCst) != UNKNOWN {
                    return Err(SessionError::Restricted);
                }
                let (records, head) =
                    finals.history.lock().map_err(|_|
                                    SessionError::Restricted)?.clone();
                self.core.history.get().ok_or(SessionError::Unavailable)?.verify_end(records,
                            &head).map_err(|_| SessionError::Unavailable)?;
                finals.mother.store(RECORDED, Ordering::SeqCst);
                Ok(())
            }
=== lane	pub mod host_session > pub mod close > impl HostSession	pub fn close_primary ( & self , seal : & CloseSeal ) -> Result < ( ) , SessionError >	count 1	bytes 1355
            pub fn close_primary(&self, seal: &CloseSeal)
                -> Result<(), SessionError> {
                route_seams::at("close.primary",
                    Ctx::session(self.core.identity));
                seal.live()?;
                if !Arc::ptr_eq(&self.core, &seal.core) {
                    return Err(SessionError::Restricted);
                }
                let finals = seal.finals()?;
                if finals.mother.load(Ordering::SeqCst) != RECORDED {
                    return Err(SessionError::Restricted);
                }
                finals.primary.compare_exchange(PENDING, UNKNOWN,
                            Ordering::SeqCst,
                            Ordering::SeqCst).map_err(|_| SessionError::Restricted)?;
                use crate::authority::evidence::EndStatus;
                match self.evidence.close_session() {
                    EndStatus::Recorded { .. } => {
                        finals.primary.store(RECORDED, Ordering::SeqCst);
                        Ok(())
                    }
                    EndStatus::Owed => {
                        finals.primary.store(FAILED_END, Ordering::SeqCst);
                        Err(SessionError::Unavailable)
                    }
                    EndStatus::Uncertain => Err(SessionError::Unavailable),
                }
            }
