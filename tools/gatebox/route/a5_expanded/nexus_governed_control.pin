        pub fn accept(&self, kind: CommandKind, sequence: u64)
            -> Result<SessionRequest, SessionError> {
            route_seams::at("ingress.accept",
                Ctx::session(self.core.identity).request(sequence));
            let accepted = Instant::now();
            let snapshot = self.core.cell.session_word();
            if snapshot & SEALED != 0 {
                return Err(SessionError::SessionEnded);
            }
            if sequence == u64::MAX {
                self.fail();
                return Err(SessionError::Exhausted);
            }
            self.core.sequence.fetch_update(Ordering::SeqCst,
                        Ordering::SeqCst,
                        |old|
                            {
                                (sequence > old).then_some(sequence)
                            }).map_err(|_| SessionError::Sequence)?;
            if kind == CommandKind::Lift {
                return Err(SessionError::Unavailable);
            }
            let target =
                match kind {
                    CommandKind::Approve =>
                        self.core.pending_context.load(Ordering::SeqCst),
                    CommandKind::Undo =>
                        self.core.undo_context.load(Ordering::SeqCst),
                    _ => 0,
                };
            if kind == CommandKind::Quit {
                let deadline = self.begin_shutdown(accepted);
                let close =
                    self.core.close.get_or_init(||
                            CloseIdentity {
                                sequence,
                                generation: snapshot / EPOCH_STEP,
                                deadline,
                            });
                let mut current = snapshot;
                loop {
                    if current & SEALED != 0 {
                        return Err(SessionError::SessionEnded);
                    }
                    if current & CLOSING != 0 { break; }
                    match self.core.cell.session_compare(current,
                            current | CLOSING) {
                        Ok(()) => break,
                        Err(now) => current = now,
                    }
                }
                return Ok(SessionRequest {
                            core: self.core.clone(),
                            kind,
                            sequence,
                            snapshot,
                            target: 0,
                            deadline: close.deadline,
                            close: Some(close.sequence),
                            scope: Arc::new(RequestScope {
                                    core: Arc::downgrade(&self.core),
                                    session: self.core.identity,
                                    request: sequence,
                                    snapshot: snapshot | CLOSING,
                                    deadline: close.deadline,
                                    kind: ScopeKind::CloseCleanup,
                                    next_step: AtomicU64::new(0),
                                    facts: outcome::RequestFacts::default(),
                                    restore: outcome::RestoreFacts::default(),
                                    mission_deadlines: OnceLock::new(),
                                    mother_run: OnceLock::new(),
                                }),
                        });
            }
            if !#[allow(non_exhaustive_omitted_patterns)] match kind {
                            CommandKind::Status | CommandKind::Evidence => true,
                            _ => false,
                        } && snapshot & (CLOSING | FAILED | EMERGENCY) != 0 {
                return Err(SessionError::Restricted);
            }
            if #[allow(non_exhaustive_omitted_patterns)] match kind {
                        CommandKind::Approve | CommandKind::Undo => true,
                        _ => false,
                    } && target == 0 {
                return Err(SessionError::NoTarget);
            }
            let seconds =
                if #[allow(non_exhaustive_omitted_patterns)] match kind {
                        CommandKind::Run | CommandKind::Approve => true,
                        _ => false,
                    } {
                    300
                } else { 120 };
            Ok(SessionRequest {
                    core: self.core.clone(),
                    kind,
                    sequence,
                    snapshot,
                    target,
                    deadline: accepted + Duration::from_secs(seconds),
                    close: None,
                    scope: Arc::new(RequestScope {
                            core: Arc::downgrade(&self.core),
                            session: self.core.identity,
                            request: sequence,
                            snapshot,
                            deadline: accepted + Duration::from_secs(seconds),
                            kind: if #[allow(non_exhaustive_omitted_patterns)] match kind
                                    {
                                    CommandKind::Undo | CommandKind::Cleanup => true,
                                    _ => false,
                                } {
                                ScopeKind::Restoration
                            } else { ScopeKind::Work },
                            next_step: AtomicU64::new(0),
                            facts: outcome::RequestFacts::default(),
                            restore: outcome::RestoreFacts::default(),
                            mission_deadlines: OnceLock::new(),
                            mother_run: OnceLock::new(),
                        }),
                })
        }
