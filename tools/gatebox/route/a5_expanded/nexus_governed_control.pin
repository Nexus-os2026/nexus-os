=== lane	pub mod host_session > pub mod close > impl CloseSeal	pub fn finish_delivery ( mut self ) -> bool	count 1	bytes 1032
            /// Called only after the final frame was acknowledged, all terminal
            /// executors joined, and terminal modes restored before this same deadline.
            pub fn finish_delivery(mut self) -> bool {
                route_seams::at("close.delivery",
                    Ctx::session(self.core.identity));
                let success =
                    self.live().is_ok() &&
                        self.finals().is_ok_and(|f|
                                {
                                    f.mother.load(Ordering::SeqCst) == RECORDED &&
                                        f.primary.load(Ordering::SeqCst) == RECORDED
                                });
                if let Ok(f) = self.finals() {
                    f.delivery.store(if success {
                            RECORDED
                        } else { FAILED_END }, Ordering::SeqCst);
                }
                finish(&self.core, success);
                self.finished = true;
                success
            }
=== lane	pub mod host_session > pub mod close > impl HostSession	pub fn close_obligations ( & self ) -> Result < CloseObligations , SessionError >	count 1	bytes 1808
            /// Observations only, collected on the bounded close worker. Failure to
            /// acquire a consistent snapshot is unknown, never zero obligations.
            pub fn close_obligations(&self)
                -> Result<CloseObligations, SessionError> {
                route_seams::at("close.obligations",
                    Ctx::session(self.core.identity));
                let (actions_unacknowledged, actions_refused) =
                    {
                        let actions =
                            self.core.actions.try_lock().map_err(|_|
                                        SessionError::Unavailable)?;
                        (actions.iter().filter(|a| !a.discharged()).count(),
                            actions.iter().filter(|a|
                                        a.refused_before_staging()).count())
                    };
                let (producers_live, producers_lost) =
                    {
                        let producers =
                            self.core.producers.try_lock().map_err(|_|
                                        SessionError::Unavailable)?;
                        (producers.slots.iter().filter(|p| p.live).count(),
                            producers.slots.iter().filter(|p| p.lost).count())
                    };
                Ok(CloseObligations {
                        model: self.core.model.snapshot().ok_or(SessionError::Unavailable)?,
                        actions_unacknowledged,
                        actions_refused,
                        producers_live,
                        producers_lost,
                        authority_closed: self.core.authority_closed.load(Ordering::SeqCst),
                        halt: self.control.authority().halt_records(),
                    })
            }
=== lane	pub mod host_session > pub mod close > impl HostSession	pub fn seal_close ( & self , request : & SessionRequest ) -> Result < CloseSeal , SessionError >	count 1	bytes 5816
            pub fn seal_close(&self, request: &SessionRequest)
                -> Result<CloseSeal, SessionError> {
                route_seams::at("close.seal",
                    Ctx::session(self.core.identity).request(request.sequence));
                self.close_request(request)?;
                if !self.report.get().is_some_and(recovery::StartupReport::ready)
                    {
                    return Err(SessionError::Unavailable);
                }
                let producers =
                    self.core.producers.lock().map_err(|_|
                                SessionError::Restricted)?;
                let word = self.core.cell.session_word();
                if word & (FAILED | SEALED) != 0 ||
                        !self.core.authority_closed.load(Ordering::SeqCst) {
                    route_seams::note("seal:restricted",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Restricted);
                }
                if producers.slots.iter().any(|s| s.live || s.lost) {
                    route_seams::note("seal:producers",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
                if !self.core.model.quiescent() {
                    route_seams::note("seal:model",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
                let stop = self.stop_obligations()?;
                if stop.received != stop.recorded ||
                                stop.received as u64 != word / EPOCH_STEP || stop.overflowed
                        || !self.core.stops.quiescent() {
                    route_seams::note("seal:stop",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
                let resources = self.resource_obligations()?;
                if resources.unresolved != 0 || resources.uncertain != 0 {
                    route_seams::note("seal:resources",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
                if self.inventory().map_err(|_|
                                            SessionError::Unavailable)?.entries.iter().any(|e|
                            !e.discharged || e.in_flight || e.uncertain) {
                    route_seams::note("seal:inventory",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
                if self.core.actions.lock().map_err(|_|
                                        SessionError::Restricted)?.iter().any(|a| !a.discharged()) {
                    route_seams::note("seal:actions",
                        Ctx::session(self.core.identity));
                    return Err(SessionError::Unavailable);
                }
