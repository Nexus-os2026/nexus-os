        pub(super) fn reserve(core: &Arc<Core>, scope: &Arc<RequestScope>)
            -> Result<Owner, SessionError> {
            route_seams::at("reg.reserve", scope.route_ctx());
            let _producers =
                core.producers.try_lock().map_err(|_|
                            SessionError::Unavailable)?;
            let mut s = hold(core)?;
            if core.cell.session_word() & SEALED != 0 || s.attempted ||
                    core.model.uncertain.load(Ordering::SeqCst) {
                return Err(SessionError::Restricted);
            }
            s.attempted = true;
            s.owner_complete = true;
            s.child_complete = true;
            if !#[allow(non_exhaustive_omitted_patterns)] match scope.kind {
                                    ScopeKind::Bootstrap => true,
                                    _ => false,
                                } || scope.session != core.identity ||
                        !scope.core.ptr_eq(&Arc::downgrade(core)) ||
                    scope.admit(&core.cell).is_err() {
                return Err(SessionError::Restricted);
            }
            s.active = true;
            s.owner_complete = false;
            s.child_complete = false;
            s.record = Some("pending");
            Ok(Owner { core: core.clone(), done: false })
        }
