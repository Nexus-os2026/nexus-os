=== ship	pub mod host_session > mod model > impl CallGate < '_ >	fn predicates ( & self , kind : RequestKind ) -> Result < ( ) , Refusal >	count 1	bytes 4807
            fn predicates(&self, kind: RequestKind) -> Result<(), Refusal> {
                use {
                    AuthorityError as E,
                    ModelError::{Cancelled, Stopped, Timeout},
                };
                let (core, scope) =
                    (&self.door.core, &self.door.context.scope);
                let clock = self.authority.clock();
                let grant =
                    OriginalGrant {
                        grants: self.authority.grants(),
                        grant: self.grant,
                        clock: (clock.monotonic_ms(), clock.wall_ms()),
                    };
                let at = self.sample();
                let expired = self.lapsed(at);
                let runs = self.authority.runs();
                let hold =
                    runs.try_request_hold().map_err(|poisoned|
                                {
                                    if poisoned {
                                        core.model.uncertain.store(true, Ordering::SeqCst);
                                        self.door.context.fail();
                                    }
                                    ("refused:hold", Cancelled)
                                })?;
                if expired { return Err(("refused:1", Timeout)); }
                let judged = scope.judge(Some(at));
                if judged == Err(crate::host_session::Lapse::Expired) {
                    return Err(("refused:1", Timeout));
                }
                let word = core.cell.session_word();
                if core.model.uncertain.load(Ordering::SeqCst) ||
                            word != scope.snapshot || judged.is_err() {
                    return Err(("refused:1", Cancelled));
                }
                self.watch.check_now().map_err(|_|
                            { ("refused:2", Stopped) })?;
                if !self.primary.try_health().is_some_and(|h|
                                !h.latched && h.owed == 0 && !h.recovery_required &&
                                    h.unsettled == 0) {
                    return Err(("refused:3", Cancelled));
                }
                if self.ticket.ended() {
                    return Err(("refused:4", Cancelled));
                }
                let _held =
                    match hold.live(self.ticket, &grant) {
                        Ok(held) => held,
                        Err(error) => {
                            drop(hold);
                            let poisoned = crate::authority::run::GRANT_POISONED;
                            if #[allow(non_exhaustive_omitted_patterns)] match error {
                                    AuthorityError::Unavailable(w) if w == poisoned => true,
                                    _ => false,
                                } {
                                core.model.uncertain.store(true, Ordering::SeqCst);
                                self.door.context.fail();
                            }
                            let grant =
                                #[allow(non_exhaustive_omitted_patterns)] match error {
                                    E::GrantNotLive | E::Unavailable(_) => true,
                                    _ => false,
                                };
                            return Err((if grant { "refused:5" } else { "refused:4" },
                                        Cancelled));
                        }
                    };
                let unspent =
                    self.charged.load(Ordering::SeqCst) &&
                        !self.spent.load(Ordering::SeqCst);
                if kind == RequestKind::Chat && !unspent {
                    return Err(("refused:6", Cancelled));
                }
                if self.invocation.is_revoked() {
                    return Err(("refused:7", Cancelled));
                }
                if let Err((error, lapse)) =
                        scope.admit_judged(&self.door.context.cell, Some(at)) {
                    drop((_held, hold));
                    if #[allow(non_exhaustive_omitted_patterns)] match error {
                            E::Capacity => true,
                            _ => false,
                        } {
                        self.door.context.fail();
                        return Err(("refused:8", Cancelled));
                    }
                    let expired =
                        lapse == Some(crate::host_session::Lapse::Expired);
                    return Err(("refused:8",
                                if expired { Timeout } else { Cancelled }));
                }
                if kind == RequestKind::Chat {
                    self.spent.store(true, Ordering::SeqCst);
                }
                Ok(())
            }
