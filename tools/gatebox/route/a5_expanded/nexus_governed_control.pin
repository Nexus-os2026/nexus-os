            pub(super) fn register_model_private(&self, endpoint: &str,
                spec: &ModelPinSpec)
                -> Result<ModelIdentityView, SessionError> {
                let deadline =
                    AbsoluteDeadline::within(SystemClocks,
                        Duration::from_secs(30));
                let mut owner = reserve(&self.core, &self.bootstrap.scope)?;
                let original_watch =
                    self.control.kernel_stop_authority().admit();
                route_seams::at("model.reserved",
                    self.bootstrap.scope.route_ctx());
                let mut record = "not_required";
                let result =
                    (||
                                {
                                    self.startup_report().require_ready()?;
                                    let watch =
                                        original_watch.map_err(|_| SessionError::Restricted)?;
                                    let gate =
                                        RegistrationGate {
                                            core: &self.core,
                                            scope: &self.bootstrap.scope,
                                            primary: &self.evidence,
                                            watch: &watch,
                                            deadline: &deadline,
                                        };
                                    let endpoint =
                                        LoopbackEndpoint::parse(endpoint).map_err(model_error)?;
                                    let transport =
                                        VerifiedOllama::verify(endpoint, spec, &gate, &deadline,
                                                    &watch).map_err(model_error)?;
                                    let model =
                                        crate::inference::RegisteredModel::verified(transport);
                                    let (identity, view) = (model.identity, model.view.clone());
                                    hold(&self.core)?.child_complete = true;
                                    record = "unknown";
                                    route_seams::at("model.record.before",
                                        self.bootstrap.scope.route_ctx());
                                    let sequence =
                                        self.control.authority().record_session_model_registered(<[_]>::into_vec(::alloc::boxed::box_new([("model_digest".into(),
                                                                        view.digest.clone()),
                                                                    ("identity".into(),
                                                                        view.identity.clone())]))).map_err(|_|
                                                    SessionError::Backend("evidence_unavailable"))?;
                                    record = "recorded";
                                    route_seams::at("model.install.before",
                                        self.bootstrap.scope.route_ctx());
                                    let mut s = hold(&self.core)?;
                                    gate.admission(&s).map_err(model_error)?;
                                    s.registration =
                                        Some(RegistrationReceipt {
                                                sequence,
                                                digest: identity,
                                                model: Arc::new(model),
                                                watch: watch.clone(),
                                                primary: self.evidence.clone(),
                                            });
                                    route_seams::at("model.install.after",
                                        self.bootstrap.scope.route_ctx());
                                    owner.complete_held(record, &mut s)?;
                                    Ok(view)
                                })();
                let completion =
                    if owner.done { Ok(()) } else { owner.complete(record) };
                match result {
                    Ok(view) => { completion?; Ok(view) }
                    Err(error) => Err(error),
                }
            }
