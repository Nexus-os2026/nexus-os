=== lane	pub mod host_session > pub mod close > impl Producer	pub fn joined ( mut self )	count 1	bytes 684
            pub fn joined(mut self) {
                route_seams::at("producer.join",
                    Ctx::session(self.core.identity));
                match self.core.producers.lock() {
                    Ok(mut producers) => {
                        let slot = &mut producers.slots[self.index];
                        if slot.live && !slot.lost &&
                                slot.generation == self.generation {
                            slot.live = false;
                            self.joined = true;
                        }
                    }
                    Err(_) => SessionIngress { core: self.core.clone() }.fail(),
                }
            }
