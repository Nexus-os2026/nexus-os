=== lane	pub mod evidence_store > impl Inner	fn pay_owed ( & mut self , written : & mut Vec < EvidenceRecord > ) -> bool	count 1	bytes 886
        /// Write every owed record, in order. False when one is still owed (it
        /// was not committed, or the store latched).
        fn pay_owed(&mut self, written: &mut Vec<EvidenceRecord>) -> bool {
            while let Some(owed) = self.owed.front() {
                let (phase, body) = (owed.phase, owed.body.clone());
                let commitment = owed.commitment.clone();
                { self.owed_flush = true; }
                match self.append(phase, commitment.as_deref(), &body) {
                    Append::Committed { .. } | Append::AlreadyPresent { .. } =>
                        {
                        if let Some(paid) = self.owed.pop_front() {
                            written.extend(paid.record);
                        }
                    }
                    _ => return false,
                }
            }
            true
        }
=== lane	pub mod evidence_store > impl Inner	fn route_refused ( & mut self , kind : & str , phase : & str , commitment : Option < & str > ) -> bool	count 1	bytes 473
        /// SB-3E S2: whether this append is the armed record's next ordinary
        /// append; if so the arming is taken (one-shot).
        fn route_refused(&mut self, kind: &str, phase: &str,
            commitment: Option<&str>) -> bool {
            let armed =
                |r: &mut (String, Option<String>)|
                    r.0 == phase && r.1.as_deref() == commitment;
            kind == "ordinary" && self.route_refuse.take_if(armed).is_some()
        }
