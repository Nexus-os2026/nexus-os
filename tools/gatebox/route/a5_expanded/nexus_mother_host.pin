    }
    #[automatically_derived]
    impl ::core::cmp::Eq for Branch {
        #[inline]
        #[doc(hidden)]
        #[coverage(off)]
        fn assert_receiver_is_total_eq(&self) -> () {}
    }
    /// What the reader knew when it recorded.
    pub(crate) struct Read {
        n: usize,
        eot: bool,
        branch: Branch,
    }
    #[automatically_derived]
    #[doc(hidden)]
    unsafe impl ::core::clone::TrivialClone for Read { }
    #[automatically_derived]
    impl ::core::clone::Clone for Read {
        #[inline]
        fn clone(&self) -> Read {
            let _: ::core::clone::AssertParamIsClone<usize>;
            let _: ::core::clone::AssertParamIsClone<bool>;
            let _: ::core::clone::AssertParamIsClone<Branch>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for Read { }
    /// `Ok(n)`: the read's length and whether it held a Ctrl-D.
    pub(crate) fn data(bytes: &[u8]) -> Read {
        let (n, eot) = (bytes.len(), bytes.contains(&4));
        Read { n, eot, branch: Branch::Data }
    }
    /// `Ok(0)` or an error: nothing was read.
    pub(crate) fn end(branch: Branch) -> Read {
        Read { n: 0, eot: false, branch }
    }
    /// One trace entry.
    pub struct Entry {
        pub tick: u64,
        pub point: &'static str,
        pub n: usize,
        pub eot: bool,
        pub branch: Branch,
        /// The recording thread: the reader's own.
        pub thread: std::thread::ThreadId,
        /// When it was recorded (position evidence only).
        pub instant: Instant,
    }
    #[automatically_derived]
    impl ::core::clone::Clone for Entry {
        #[inline]
        fn clone(&self) -> Entry {
            Entry {
                tick: ::core::clone::Clone::clone(&self.tick),
                point: ::core::clone::Clone::clone(&self.point),
                n: ::core::clone::Clone::clone(&self.n),
                eot: ::core::clone::Clone::clone(&self.eot),
                branch: ::core::clone::Clone::clone(&self.branch),
                thread: ::core::clone::Clone::clone(&self.thread),
                instant: ::core::clone::Clone::clone(&self.instant),
            }
        }
    }
    #[automatically_derived]
    impl ::core::fmt::Debug for Entry {
