                                    ::alloc::fmt::format(format_args!("CLOSE AUTHORITY closed={0} actions_unacknowledged={1} producers_live={2} producers_lost={3} halt_pending={4} halt_owed={5} halt_uncertain={6} halt_lost={7}\n",
