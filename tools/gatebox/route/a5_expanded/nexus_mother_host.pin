        fn close_report(&self, stage: &str) -> String {
            route_seams::at("host.close_report",
                route_seams::report(&self.home.session, stage, None, None));
            let mut report =
                ::alloc::__export::must_use({
                        ::alloc::fmt::format(format_args!("CLOSE FAILED stage={0}\n",
                                stage))
                    });
            let resources = self.home.session.resource_obligations();
            route_seams::at("host.close_report.resources",
                route_seams::report(&self.home.session, stage,
                    Some(resources.is_ok()), None));
            match resources {
                Ok(r) =>
                    report.push_str(&::alloc::__export::must_use({
                                    ::alloc::fmt::format(format_args!("CLOSE OBLIGATIONS reservations_unresolved={0} uncertain={1} private={2} private_unresolved={3}\n",
                                            r.unresolved, r.uncertain, r.private, r.private_unresolved))
                                })),
                Err(_) => report.push_str(CLOSE_UNKNOWN),
            }
            let inventory = self.home.session.inventory();
            route_seams::at("host.close_report.inventory",
                route_seams::report(&self.home.session, stage,
                    Some(inventory.is_ok()), None));
            match inventory {
                Ok(inventory) => {
                    for e in inventory.entries {
                        report.push_str(&::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("CLOSE RESOURCE request={0} in_flight={1} uncertain={2} discharged={3} staging_absent={4} private_finalization_established={5} parent_synced={6} grants_closed={7} cleanup_recorded={8} intentionally_retained={9}\n",
                                                e.request, e.in_flight, e.uncertain, e.discharged,
                                                e.staging_absent, e.private_finalization_established,
                                                e.parent_synced, e.grants_closed, e.cleanup_recorded,
                                                e.intentionally_retained))
                                    }));
                    }
                }
                Err(_) => report.push_str(CLOSE_UNKNOWN),
            }
            let model = self.home.session.close_obligations();
            route_seams::at("host.close_report.model",
                route_seams::report(&self.home.session, stage,
                    Some(model.is_ok()), None));
            report.push_str(&model_report(model.as_ref().ok().map(|o|
                                o.model)));
            match model {
