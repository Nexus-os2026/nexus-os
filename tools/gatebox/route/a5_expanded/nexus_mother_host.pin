    /// What the recording host code knew: the reader's read, or (U21a) the
    /// close worker's session, its state, the report's stage, a branch's
    /// outcome and, at the exit, the report.
    pub(crate) struct Read {
        n: usize,
        eot: bool,
        branch: Branch,
        report: Option<Report>,
    }
    struct Report {
        session: SessionIdentity,
        state: SessionState,
        stage: String,
        known: Option<bool>,
        text: Option<String>,
    }
    /// `Ok(n)`: the read's length and whether it held a Ctrl-D.
    pub(crate) fn data(bytes: &[u8]) -> Read {
        let (n, eot) = (bytes.len(), bytes.contains(&4));
        Read { n, eot, branch: Branch::Data, report: None }
    }
    /// `Ok(0)` or an error: nothing was read.
    pub(crate) fn end(branch: Branch) -> Read {
        Read { n: 0, eot: false, branch, report: None }
    }
    /// U21a: a `close_report` point of `session`'s close worker: its state now,
    /// the report's `stage`, a branch's outcome (`Ok`: `Some(true)`) and, at the
    /// exit, the report text.
    pub(crate) fn report(session: &HostSession, stage: &str,
        known: Option<bool>, text: Option<&str>) -> Read {
        let report =
            Report {
                session: session.identity(),
                state: session.state(),
                stage: stage.to_owned(),
                known,
                text: text.map(str::to_owned),
            };
        Read {
            n: 0,
            eot: false,
            branch: Branch::Report,
            report: Some(report),
        }
    }
    /// One trace entry.
    pub struct Entry {
        pub tick: u64,
        pub point: &'static str,
        pub n: usize,
        pub eot: bool,
        pub branch: Branch,
        /// U21a: a `close_report` point's session, state, stage, branch outcome
        /// and (exit) report; `None` at `host.read`.
        pub session: Option<SessionIdentity>,
        pub state: Option<SessionState>,
        pub stage: Option<String>,
        pub known: Option<bool>,
        pub text: Option<String>,
        /// The recording thread: the reader's or the close worker's own.
        pub thread: std::thread::ThreadId,
        /// When it was recorded (position evidence only).
        pub instant: Instant,
    }
    #[automatically_derived]
    impl ::core::clone::Clone for Entry {
        #[inline]
        fn clone(&self) -> Entry {
            Entry {
                tick: ::core::clone::Clone::clone(&self.tick),
                point: ::core::clone::Clone::clone(&self.point),
                n: ::core::clone::Clone::clone(&self.n),
                eot: ::core::clone::Clone::clone(&self.eot),
                branch: ::core::clone::Clone::clone(&self.branch),
                session: ::core::clone::Clone::clone(&self.session),
                state: ::core::clone::Clone::clone(&self.state),
                stage: ::core::clone::Clone::clone(&self.stage),
                known: ::core::clone::Clone::clone(&self.known),
                text: ::core::clone::Clone::clone(&self.text),
                thread: ::core::clone::Clone::clone(&self.thread),
                instant: ::core::clone::Clone::clone(&self.instant),
            }
        }
    }
    #[automatically_derived]
    impl ::core::fmt::Debug for Entry {
        #[inline]
        fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
            let names: &'static _ =
                &["tick", "point", "n", "eot", "branch", "session", "state",
                            "stage", "known", "text", "thread", "instant"];
            let values: &[&dyn ::core::fmt::Debug] =
                &[&self.tick, &self.point, &self.n, &self.eot, &self.branch,
                            &self.session, &self.state, &self.stage, &self.known,
                            &self.text, &self.thread, &&self.instant];
            ::core::fmt::Formatter::debug_struct_fields_finish(f, "Entry",
                names, values)
        }
    }
    #[automatically_derived]
    impl ::core::marker::StructuralPartialEq for Entry { }
    #[automatically_derived]
    impl ::core::cmp::PartialEq for Entry {
        #[inline]
        fn eq(&self, other: &Entry) -> bool {
            self.tick == other.tick && self.eot == other.eot &&
                                                    self.point == other.point && self.n == other.n &&
                                            self.branch == other.branch && self.session == other.session
                                    && self.state == other.state && self.stage == other.stage &&
                            self.known == other.known && self.text == other.text &&
                    self.thread == other.thread && self.instant == other.instant
        }
    }
    #[automatically_derived]
    impl ::core::cmp::Eq for Entry {
        #[inline]
        #[doc(hidden)]
        #[coverage(off)]
        fn assert_receiver_is_total_eq(&self) -> () {
            let _: ::core::cmp::AssertParamIsEq<u64>;
            let _: ::core::cmp::AssertParamIsEq<&'static str>;
            let _: ::core::cmp::AssertParamIsEq<usize>;
            let _: ::core::cmp::AssertParamIsEq<bool>;
            let _: ::core::cmp::AssertParamIsEq<Branch>;
            let _: ::core::cmp::AssertParamIsEq<Option<SessionIdentity>>;
            let _: ::core::cmp::AssertParamIsEq<Option<SessionState>>;
            let _: ::core::cmp::AssertParamIsEq<Option<String>>;
            let _: ::core::cmp::AssertParamIsEq<Option<bool>>;
            let _: ::core::cmp::AssertParamIsEq<Option<String>>;
            let _: ::core::cmp::AssertParamIsEq<std::thread::ThreadId>;
            let _: ::core::cmp::AssertParamIsEq<Instant>;
        }
    }
    /// A pause's timeout: given the `TIMEOUT <cell> <point>` line, the harness
    /// records it and ends the process; it cannot return (`!`).
    pub type Timeout = fn(&str) -> !;
    /// What an armed point does. Every arming turns recording on.
    pub enum Action {

        /// Record only.
        Trace,

        /// At the first arrival: acknowledge, then block the reader until the
        /// [`Held`] is dropped; not released within 10 s, `timeout` ends it.
        Pause {
            cell: &'static str,
            timeout: Timeout,
        },

        /// U21a (SB3E-R140 Q3): at the first arrival, acknowledge, then begin
        /// an unwind.
        Panic,
    }
    /// One arming. Dropping it releases its pause, or disarms it if it has not
    /// fired; that never panics.
    pub struct Held {
        pub acknowledged: Receiver<Entry>,
        _release: Release,
    }
    struct Release(u64, SyncSender<()>);
    impl Drop for Release {
        fn drop(&mut self) {
            state().pending.retain(|p| p.id != self.0);
            let _ = self.1.try_send(());
        }
    }
    /// Arm `point` (one of [`POINTS`]) with `action`.
    pub fn arm(point: &'static str, action: Action) -> Held {
        if !POINTS.contains(&point) {
            {
                ::core::panicking::panic_fmt(format_args!("not a host route point: {0}",
                        point));
            }
        };
        let (ack, acknowledged) = sync_channel(1);
        let (release, released) = sync_channel(1);
        let mut s = state();
        s.tick += 1;
        let id = s.tick;
        let pause =
            match action {
                Action::Trace => None,
                Action::Pause { cell, timeout } =>
                    Some(Some((released, cell, timeout))),
                Action::Panic => Some(None),
            };
        if let Some(pause) = pause {
            s.pending.push(Pending { id, point, ack, pause });
        }
        ARMED.store(true, Ordering::SeqCst);
        Held { acknowledged, _release: Release(id, release) }
    }
    /// Every entry recorded so far, in tick order; the trace is emptied.
    pub fn drain_trace() -> Vec<Entry> {
        std::mem::take(&mut state().entries)
    }
    /// A reader point. Unarmed, this is the marker and one relaxed load.
    pub(crate) fn at(point: &'static str, read: Read) {
        std::hint::black_box(M.as_bytes());
        if !ARMED.load(Ordering::Relaxed) { return; }
        fire(point, read);
    }
    fn state() -> MutexGuard<'static, State> {
        STATE.lock().unwrap_or_else(PoisonError::into_inner)
    }
    fn fire(point: &'static str, read: Read) {
        let (entry, pending) =
            {
                let mut s = state();
                s.tick += 1;
                let report = read.report;
                let entry =
                    Entry {
                        tick: s.tick,
                        point,
                        n: read.n,
                        eot: read.eot,
                        branch: read.branch,
                        session: report.as_ref().map(|r| r.session),
                        state: report.as_ref().map(|r| r.state),
                        stage: report.as_ref().map(|r| r.stage.clone()),
                        known: report.as_ref().and_then(|r| r.known),
                        text: report.and_then(|r| r.text),
                        thread: std::thread::current().id(),
                        instant: Instant::now(),
                    };
                s.entries.push(entry.clone());
                let found = s.pending.iter().position(|p| p.point == point);
                (entry, found.map(|i| s.pending.remove(i)))
            };
        let Some(pending) = pending else { return };
        let acknowledged = pending.ack.try_send(entry).is_ok();
        let Some((released, cell, timeout)) =
            pending.pause else {
                {
                    ::core::panicking::panic_fmt(format_args!("route seam S7: armed panic at {0}",
                            point));
                };
            };
        if !acknowledged || released.recv_timeout(PATIENCE).is_err() {
            timeout(&::alloc::__export::must_use({
                            ::alloc::fmt::format(format_args!("TIMEOUT {0} {1}", cell,
                                    point))
                        }));
        }
    }
}
