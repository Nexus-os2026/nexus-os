    fn read_input(shared: Arc<Shared>) {
        let stdin = std::io::stdin();
        let mut buffers = Buffers::default();
        while !shared.input_end.load(Ordering::SeqCst) {
            let boundary =
                {
                    let input = shared.input();
                    (input.boundary !=
                                input.acknowledged).then_some(input.boundary)
                };
            if boundary.is_some() { buffers.invalidate(); }
            let mut fds = [PollFd::new(stdin.as_fd(), PollFlags::POLLIN)];
            let ready =
                match poll(&mut fds,
                        if boundary.is_some() { 0u16 } else { 10u16 }) {
                    Ok(n) => n,
                    Err(nix::errno::Errno::EINTR) => continue,
                    Err(_) => {
                        shared.stop.press();
                        shared.fail(Failure::Input);
                        break;
                    }
                };
            if ready == 0 {
                if let Some(boundary) = boundary {
                    shared.acknowledge(boundary);
                }
                continue;
            }
            let mut bytes = [0u8; 256];
            match nix::unistd::read(stdin.as_raw_fd(), &mut bytes) {
                Ok(0) => { shared.receive(Line::Eof, true); break; }
                Ok(n) => {
                    let mode = reader_state(&shared, boundary);
                    route_read(&shared, &mut buffers, &bytes[..n], mode);
                    if shared.ended() { break; }
                }
                Err(nix::errno::Errno::EINTR) => {}
                Err(_) => {
                    shared.stop.press();
                    shared.fail(Failure::Input);
                    break;
                }
            }
        }
    }
