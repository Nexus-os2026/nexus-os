        /// SB-3E S6 (design 4.2, 4.3): bind stop recording to `session` as
        /// production does once the home is open (hands.rs `StopRoute::bind`).
        /// Route lane only.
        pub fn route_bind(&self,
            session: Arc<nexus_governed_control::host_session::HostSession>)
            -> bool {
            const M: &str = "nexus-mother-route-seam-S6";
            std::hint::black_box(M.as_bytes());
            self.shared.stop.bind(session)
        }
=== lane	pub mod terminal	fn read_input ( shared : Arc < Shared > )	count 1	bytes 2218
    fn read_input(shared: Arc<Shared>) {
        let stdin = std::io::stdin();
        let mut buffers = Buffers::default();
        while !shared.input_end.load(Ordering::SeqCst) {
            let boundary =
                {
                    let input = shared.input();
                    (input.boundary !=
                                input.acknowledged).then_some(input.boundary)
                };
            if boundary.is_some() { buffers.invalidate(); }
            let mut fds = [PollFd::new(stdin.as_fd(), PollFlags::POLLIN)];
            let ready =
                match poll(&mut fds,
                        if boundary.is_some() { 0u16 } else { 10u16 }) {
                    Ok(n) => n,
                    Err(nix::errno::Errno::EINTR) => continue,
                    Err(_) => {
                        shared.stop.press();
                        shared.fail(Failure::Input);
                        break;
                    }
                };
            if ready == 0 {
                if let Some(boundary) = boundary {
                    shared.acknowledge(boundary);
                }
                continue;
            }
            let mut bytes = [0u8; 256];
            match nix::unistd::read(stdin.as_raw_fd(), &mut bytes) {
                Ok(0) => {
                    shared.receive(Line::Eof, true);
                    route_seams::at("host.read",
                        route_seams::end(route_seams::Branch::Zero));
                    break;
                }
                Ok(n) => {
                    let mode = reader_state(&shared, boundary);
                    route_read(&shared, &mut buffers, &bytes[..n], mode);
                    route_seams::at("host.read",
                        route_seams::data(&bytes[..n]));
                    if shared.ended() { break; }
                }
                Err(nix::errno::Errno::EINTR) => {}
                Err(_) => {
                    shared.stop.press();
                    shared.fail(Failure::Input);
                    route_seams::at("host.read",
                        route_seams::end(route_seams::Branch::Err));
                    break;
                }
            }
        }
    }
