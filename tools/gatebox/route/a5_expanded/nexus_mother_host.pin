                                    h.latched, h.owed, h.recovery_required, h.unsettled,
                                    h.unclean_sessions))
                        }));
            route_seams::at("host.close_report.string",
                route_seams::report(&self.home.session, stage, None,
                    Some(&report)));
            report
        }
