[Unit]
Description=Gate Box supervisor
Requires=mothergate.socket
After=mothergate.socket
RequiresMountsFor=/var/lib/mothergate

[Service]
Type=exec
User=mothergate
Group=mothergate
SupplementaryGroups=
UMask=0077
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /usr/libexec/gatebox/supervisor.py
ReadWritePaths=/run/mothergate-control
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/nexus/NEXUS/nexus-os/.git:/var/lib/gatebox-source
ReadWritePaths=/var/lib/mothergate
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=no
MemoryAccounting=yes
MemoryMax=8G
MemorySwapMax=0
TasksMax=64
LimitCORE=0
LimitNOFILE=256
TimeoutStopSec=30s
KillMode=control-group
Restart=no
StandardInput=null
StandardOutput=null
StandardError=null
