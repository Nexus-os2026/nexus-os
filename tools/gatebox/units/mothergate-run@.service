[Unit]
Description=Gate Box payload %i
BindsTo=mothergate.service
After=mothergate.service
RequiresMountsFor=/var/lib/mothergate
AllowIsolate=no

[Service]
Type=exec
ExitType=main
User=gaterun
Group=gaterun
DynamicUser=no
SupplementaryGroups=
UMask=0077
RootDirectory=/usr/lib/gatebox/root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /gate/bin/init.py

PrivateUsers=no
PrivatePIDs=yes
PrivateIPC=yes
PrivateNetwork=yes
PrivateMounts=yes
PrivateTmp=no
PrivateDevices=yes
MountAPIVFS=yes
BindLogSockets=no
ProtectHostname=private:gatebox
ProtectProc=default
ProcSubset=all

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=no
RestrictNamespaces=no
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
LockPersonality=yes
RestrictRealtime=yes
KeyringMode=private
DevicePolicy=closed
Delegate=no

SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~@obsolete @raw-io @reboot @swap @module @clock @cpu-emulation @debug @keyring bpf userfaultfd io_uring_setup process_vm_readv process_vm_writev

BindReadOnlyPaths=/usr:/usr:norbind
BindReadOnlyPaths=/opt/google/chrome
BindReadOnlyPaths=/usr/libexec/gatebox:/gate/bin
BindReadOnlyPaths=/etc/gatebox:/gate/policy
BindReadOnlyPaths=/home/nexus/.rustup/toolchains/1.94.0-x86_64-unknown-linux-gnu:/opt/rust
BindReadOnlyPaths=/home/nexus/.cargo/registry:/inputs/registry
BindReadOnlyPaths=/var/lib/mothergate/staging/%i/snapshot:/input
BindReadOnlyPaths=/var/lib/mothergate/staging/%i/request.json:/gate/request.json
InaccessiblePaths=+/usr/share/ollama
InaccessiblePaths=-+/usr/share/glvnd/egl_vendor.d/10_nvidia.json
TemporaryFileSystem=/usr/local:ro,nodev,nosuid,noexec,mode=0755,uid=0,gid=0,size=1M,nr_inodes=16

TemporaryFileSystem=/work:rw,nodev,nosuid,mode=0700,uid=@GATERUN_UID@,gid=@GATERUN_GID@,size=16G,nr_inodes=1048576
TemporaryFileSystem=/run:rw,nodev,nosuid,noexec,mode=0755,uid=0,gid=0,size=16M,nr_inodes=4096
TemporaryFileSystem=/run/gate:rw,nodev,nosuid,mode=0700,uid=@GATERUN_UID@,gid=@GATERUN_GID@,size=4G,nr_inodes=262144
TemporaryFileSystem=/tmp:rw,nodev,nosuid,mode=1777,uid=0,gid=0,size=512M,nr_inodes=65536
TemporaryFileSystem=/dev/shm:rw,nodev,nosuid,noexec,mode=1777,uid=0,gid=0,size=512M,nr_inodes=65536

MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryMax=24G
MemorySwapMax=0
TasksMax=4096
CPUQuota=800%
OOMPolicy=kill
LimitCORE=0
LimitNOFILE=4096
LimitFSIZE=8G
RuntimeMaxSec=14400s

TimeoutStartSec=30s
TimeoutStopSec=15s
TimeoutStopFailureMode=kill
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=no
RemainAfterExit=no
NotifyAccess=none

StandardInput=null
StandardOutput=file:/run/mothergate-control/sealed/%i/log.sock
StandardError=file:/run/mothergate-control/sealed/%i/status.sock
